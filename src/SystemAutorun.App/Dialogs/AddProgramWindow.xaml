<ui:FluentWindow x:Class="SystemAutorun.App.Dialogs.AddProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="添加程序任务"
        Width="720"
        Height="510"
        MinWidth="660"
        MinHeight="470"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="14" Padding="18,16" Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="4"
                       Style="{StaticResource PanelTitleTextStyle}"
                       Text="添加程序任务" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="任务名称" />
            <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" />

            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="程序路径" />
            <TextBox x:Name="ExecutableTextBox" Grid.Row="4" Grid.Column="1" />
            <Button Grid.Row="4" Grid.Column="3" Click="Browse_Click">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" />
                    <TextBlock Text="浏览" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="启动参数" />
            <TextBox x:Name="ArgumentsTextBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" />

            <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="工作目录" />
            <TextBox x:Name="WorkingDirectoryTextBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" />

            <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="任务描述" />
            <TextBox x:Name="DescriptionTextBox" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" />

            <TextBlock Grid.Row="12" VerticalAlignment="Center" Text="启动延迟（秒）" />
            <TextBox x:Name="DelayTextBox" Grid.Row="12" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="5" />

            <StackPanel Grid.Row="14"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="100" Margin="0,0,10,0" IsCancel="True" Content="取消" />
                <Button Width="110"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"
                        Content="添加任务" />
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>

<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="日志" Width="800" Height="500" MinWidth="760" MinHeight="460"
        FontSize="13" FontFamily="{StaticResource Semantic.Font.Interface}" Foreground="{DynamicResource Semantic.Brush.TextPrimary}"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}" /></Window.InputBindings>
    <Window.Resources>
        <Style x:Key="LogEventItem" TargetType="ListBoxItem" BasedOn="{StaticResource DashboardSequenceItem}">
            <Setter Property="MinHeight" Value="48" /><Setter Property="Padding" Value="20,10" />
            <Setter Property="services:ColorStateAssist.HoverAction" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}" /><Setter Property="AutomationProperties.HelpText" Value="{Binding Notice}" />
        </Style>
        <Style x:Key="LogFilterLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" /></Style>
    </Window.Resources>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
    <Border Background="{DynamicResource Semantic.Brush.WindowBackground}" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="56" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- R105: a tool window offers only close, so it never reads as a second main window. -->
                        <Button x:Name="CloseButton" Style="{StaticResource DashboardIconButton}" Click="Close_Click" ToolTip="关闭日志，不停止服务" AutomationProperties.Name="关闭日志"><controls:LineIcon Kind="Close" /></Button>
                    </StackPanel>
                    <TextBlock Text="日志" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="12,0">
                <DockPanel>
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource DashboardIconButton}" Click="Close_Click" ToolTip="返回服务监控 (Esc)" AutomationProperties.Name="返回服务监控"><controls:LineIcon Kind="Back" /></Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FollowLabel}" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                        <Button x:Name="FollowButton" Style="{StaticResource DashboardIconButton}" Command="{Binding FollowCommand}" ToolTip="暂停或继续追踪" AutomationProperties.Name="暂停或继续追踪"><controls:LineIcon Kind="{Binding FollowIcon}" /></Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource DashboardIconButton}" Command="{Binding RefreshCommand}" ToolTip="刷新来源及最近页 (F5)" AutomationProperties.Name="刷新日志"><controls:LineIcon Kind="Refresh" /></Button>
                        <Button x:Name="ExportButton" Style="{StaticResource DashboardIconButton}" IsEnabled="{Binding CanExport}" Click="Export_Click" ToolTip="导出当前页到新文件" AutomationProperties.Name="导出当前页"><controls:LineIcon Kind="Export" /></Button>
                    </StackPanel>
                    <Border />
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Padding="20,12,20,6" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                <WrapPanel>
                    <StackPanel Width="180" Margin="0,0,16,8"><TextBlock Text="服务" Style="{StaticResource LogFilterLabel}" /><ComboBox x:Name="TaskBox" FontSize="14" ItemsSource="{Binding TaskNames}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="日志服务" /></StackPanel>
                    <StackPanel Width="300" Margin="0,0,16,8"><TextBlock Text="来源" Style="{StaticResource LogFilterLabel}" /><ComboBox x:Name="SourceBox" FontSize="14" ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSource}" AutomationProperties.Name="日志来源" ToolTip="{Binding SelectedSource.Label}" /></StackPanel>
                    <StackPanel Width="132" Margin="0,0,16,8"><TextBlock Text="级别" Style="{StaticResource LogFilterLabel}" /><ComboBox x:Name="LevelBox" FontSize="14" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" AutomationProperties.Name="日志级别" /></StackPanel>
                    <StackPanel Width="300" Margin="0,0,16,8"><TextBlock Text="起始时间（含时区，可留空）" Style="{StaticResource LogFilterLabel}" /><Grid><TextBox x:Name="SinceBox" FontSize="14" FontFamily="{StaticResource Semantic.Font.Monospace}" Text="{Binding SinceText, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 2026-11-03 09:00 +08:00；更改条件后刷新或从头读取" AutomationProperties.Name="日志起始时间" AutomationProperties.HelpText="格式 yyyy-MM-dd HH:mm +08:00，可留空" />
                    <!-- Format example only while empty; it never becomes the value or blocks input. -->
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" FontFamily="{StaticResource Semantic.Font.Monospace}" Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="yyyy-MM-dd HH:mm +08:00"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=SinceBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel>
                </WrapPanel>
            </Border>
            <Border Grid.Row="3" Padding="20,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                <Grid VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Semantic.Brush.TextSecondary}" TextElement.FontSize="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="270" /><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="时间" /><TextBlock Grid.Column="2" Text="级别" /><TextBlock Grid.Column="3" Text="日志消息" />
                </Grid>
            </Border>
            <ListBox x:Name="EventList" Grid.Row="4" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ItemContainerStyle="{StaticResource LogEventItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="日志事件">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid MinHeight="24"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="270" /><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:LineIcon Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><controls:LineIcon.Style><Style TargetType="controls:LineIcon"><Setter Property="Kind" Value="Forward" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Kind" Value="Down" /></DataTrigger></Style.Triggers></Style></controls:LineIcon.Style></controls:LineIcon>
                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Level}" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="14" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="error"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" /></DataTrigger><DataTrigger Binding="{Binding Level}" Value="critical"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" /></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" /></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Grid.Column="3" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Margin="28,10,0,4" Padding="12,8" Background="{DynamicResource Semantic.Brush.TerminalBackground}" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="1" Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <!-- The owning row's existing summary is this region's color focus caption. -->
                                <TextBox Text="{Binding Raw, Mode=OneWay}" IsReadOnly="True" services:ColorStateAssist.Role="None" Style="{StaticResource LogTextBoxStyle}" Foreground="{DynamicResource Semantic.Brush.TextPrimary}" FontSize="16" BorderThickness="0" Background="Transparent" Padding="0,8" MinHeight="48" MaxHeight="280" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="事件完整原文" />
                                <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="5" Padding="12,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RecentButton" Content="最近" Style="{StaticResource DashboardRangeButton}" services:ColorStateAssist.Role="Foreground" Command="{Binding RecentCommand}" ToolTip="重读最近的有界页，不表示全部历史" />
                    <Button x:Name="FromStartButton" Content="从头" Style="{StaticResource DashboardRangeButton}" services:ColorStateAssist.Role="Foreground" Command="{Binding FromStartCommand}" />
                    <Button x:Name="NextButton" Style="{StaticResource DashboardIconButton}" Command="{Binding NextCommand}" ToolTip="下一页" AutomationProperties.Name="下一页"><controls:LineIcon Kind="Forward" /></Button>
                    <TextBlock Text="每页" FontSize="14" VerticalAlignment="Center" Margin="24,0,8,0" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                    <ComboBox x:Name="PageSizeBox" Width="92" FontSize="14" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" AutomationProperties.Name="每页条数" />
                </StackPanel>
            </Border>
            <Border Grid.Row="6" Padding="20,8" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" AutomationProperties.Name="日志读取状态" />
            </Border>
        </Grid>
    </Border>
    </controls:PresencePanel>
</services:ToolWindow>

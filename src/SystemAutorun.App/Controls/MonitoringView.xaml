<?xml version="1.0" encoding="utf-8"?>
<!-- R105: the host and exception-log views are tabs of the main window, peers of the service view.
     Content is the R104 monitoring layout without its own window caption. -->
<UserControl Background="{DynamicResource Semantic.Brush.WindowBackground}" x:Class="SystemAutorun.App.Controls.MonitoringView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SystemAutorun.App.Controls" xmlns:services="clr-namespace:SystemAutorun.App.Services" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <UserControl.Resources>
    <Style x:Key="HostTabItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.RowRest}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Semantic.Brush.BorderSubtle}" />
      <Setter Property="services:ColorStateAssist.Role" Value="Row" />
      <Setter Property="services:ColorStateAssist.HoverAction" Value="True" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusDetail}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="TabSurface" services:SurfaceMotion.Fill="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActive}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                <Setter TargetName="TabSurface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HostStatusIconStyle" TargetType="controls:LineIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Kind" Value="Disabled" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextDisabled}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="OK">
          <Setter Property="Kind" Value="Check" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusHealthy}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="FAIL">
          <Setter Property="Kind" Value="Warning" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="UNKNOWN">
          <Setter Property="Kind" Value="Help" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ServerStatusIconStyle" TargetType="controls:LineIcon" BasedOn="{StaticResource HostStatusIconStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ServerStatus}" Value="OK">
          <Setter Property="Kind" Value="Check" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusHealthy}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ServerStatus}" Value="FAIL">
          <Setter Property="Kind" Value="Warning" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ServerStatusTextStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
      <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ServerStatus}" Value="OK">
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusHealthy}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ServerStatus}" Value="FAIL">
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HostMeterStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="2" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource Semantic.Brush.BorderSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SummaryReadoutStyle" TargetType="TextBlock">
      <Setter Property="services:LineMotion.Stage" Value="Readout" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
    </Style>
    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
    </Style>
    <Style x:Key="SectionCountStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
      <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" />
    </Style>
    <Style x:Key="ResourceRowStyle" TargetType="Border">
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="BorderBrush" Value="{DynamicResource Semantic.Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="CountTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
    </Style>
    <Style x:Key="LogLevelTextStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
      <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusWarning}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="CRITICAL">
          <!-- R128: active row stays grey+red; critical badge keeps crimson fill at rest and inverts cleanly on hover. -->
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.OnStatus}" />
          <Setter Property="Background" Value="{DynamicResource Semantic.Brush.StatusCritical}" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="HorizontalAlignment" Value="Left" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="ERROR">
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Level}" Value="CRITICAL" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource Semantic.Brush.StatusCritical}" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.OnStatus}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Level}" Value="CRITICAL" />
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource Semantic.Brush.OnStatus}" />
          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusCritical}" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="InspectorLabelTextStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,12,8" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" />
    </Style>
    <Style x:Key="InspectorValueTextStyle" TargetType="TextBlock">
      <Setter Property="services:LineMotion.Stage" Value="Readout" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
      <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
      <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
      <!-- Overview: host list beside the selected host. Remote hosts stay read-only. -->
      <controls:PresencePanel x:Name="HostPage" Grid.Row="0" MotionKind="Page" Background="{DynamicResource Semantic.Brush.WindowBackground}" IsPresented="{Binding IsOverviewPage}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width=".3*" MinWidth="240" MaxWidth="340" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="ToggleHostsSidebarButton" Style="{StaticResource DashboardIconButton}" Width="32" Height="32" Padding="8" VerticalAlignment="Center"
                          Command="{x:Static services:SidebarAssist.ToggleCommand}" CommandParameter="{Binding ElementName=HostPage}"
                          ToolTip="折叠或展开服务器列表" AutomationProperties.Name="折叠或展开服务器列表"><controls:LineIcon Kind="Menu" Width="16" Height="16" /></Button>
                  <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                             Visibility="{Binding ElementName=HostPage, Path=(services:SidebarAssist.ExpandedVisibility)}"
                             Text="{Binding Hosts.Count, StringFormat={}{0} 个服务器}" ToolTip="服务器数量" />
                </StackPanel>
                <!-- R105: moved here from the retired monitoring window's caption. -->
                <Button x:Name="ManageRemoteHostsButton" Grid.Column="1" Style="{StaticResource DashboardIconButton}" Width="32" Height="32" Padding="8" VerticalAlignment="Center"
                        Visibility="{Binding ElementName=HostPage, Path=(services:SidebarAssist.ExpandedVisibility)}"
                        AutomationProperties.Name="添加服务器" ToolTip="添加服务器" Command="{Binding ManageRemoteHostsCommand}">
                  <controls:LineIcon Kind="Plus" Width="16" Height="16" />
                </Button>
              </Grid>
            </Border>
            <Button Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0" Style="{StaticResource DashboardIconButton}"
                    Visibility="{Binding ElementName=HostPage, Path=(services:SidebarAssist.CollapsedVisibility)}"
                    Command="{Binding ManageRemoteHostsCommand}" AutomationProperties.Name="添加服务器" ToolTip="添加服务器"><controls:LineIcon Kind="Plus" /></Button>
            <ListBox x:Name="HostList" Grid.Row="1" Visibility="{Binding ElementName=HostPage, Path=(services:SidebarAssist.ExpandedVisibility)}" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHostTab}" ItemContainerStyle="{StaticResource HostTabItemStyle}" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" AutomationProperties.Name="主机选项" KeyboardNavigation.TabNavigation="Once" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseRightButtonDown="HostList_PreviewMouseRightButtonDown"
                     ContextMenuOpening="HostList_ContextMenuOpening"
                     MouseDoubleClick="HostList_MouseDoubleClick"
                     PreviewMouseLeftButtonDown="HostList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="HostList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="HostList_PreviewMouseLeftButtonUp"
                     LostMouseCapture="HostList_LostMouseCapture">
              <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="编辑服务器" Command="{Binding EditRemoteHostCommand}" CommandParameter="{Binding SelectedHostTab}" />
                  <Separator />
                  <MenuItem Header="删除服务器…" Command="{Binding RemoveRemoteHostCommand}" CommandParameter="{Binding SelectedHostTab}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding StatusDetail}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                      <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasHighResourceUsage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          <DataTrigger Binding="{Binding IsLocal}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                      </Style></StackPanel.Style>
                      <controls:LineIcon Kind="Warning" Width="15" Height="15" VerticalAlignment="Center"
                                         AutomationProperties.Name="主机资源高占用注意"
                                         ToolTip="{Binding HighResourceSummary}">
                        <controls:LineIcon.Style><Style TargetType="controls:LineIcon">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusWarning}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHighResourceUsage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsLocal}" Value="True"><Setter Property="Margin" Value="0,0,6,0" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" /></DataTrigger>
                          </Style.Triggers>
                        </Style></controls:LineIcon.Style>
                      </controls:LineIcon>
                      <TextBlock VerticalAlignment="Center" FontSize="12" Text="本机"
                                 Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock.Style><Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" /></DataTrigger>
                          </Style.Triggers>
                        </Style></TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid services:SurfaceMotion.TransitionKey="{Binding SelectedHostTab.Id}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- R109: the former "运行保障" column is gone; diagnostics and login startup live in the settings menu. -->
          <Border x:Name="HostHeader" services:LineMotion.Region="0" MinHeight="72" Padding="20,14" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource InteractiveFrameBorderStyle}" Background="Transparent" BorderThickness="1">
                  <controls:LineIcon x:Name="HostOsIcon" Kind="{Binding HostIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="19" LineHeight="22" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Text="{Binding HostName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostName}" />
                    <Border x:Name="HostStatusSummary" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ServerStatusDetail}" AutomationProperties.Name="主机状态" AutomationProperties.HelpText="{Binding ServerStatusDetail}">
                      <Border.Style><Style TargetType="Border"><Style.Triggers>
                        <DataTrigger Binding="{Binding ServerStatus}" Value="OK"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                      </Style.Triggers></Style></Border.Style>
                      <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Style="{StaticResource ServerStatusIconStyle}" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource ServerStatusTextStyle}" Text="{Binding ServerStatus}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock Margin="0,1,0,0" FontSize="13" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" Text="{Binding HostOs}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostOs}" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <StackPanel Margin="0,0,22,0" Orientation="Horizontal" ToolTip="运行时间" AutomationProperties.Name="运行时间">
                  <controls:LineIcon Kind="Clock" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                  <TextBlock Style="{StaticResource SummaryReadoutStyle}" Text="{Binding HostUptime}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" ToolTip="进程 / 线程" AutomationProperties.Name="进程与线程">
                  <controls:LineIcon Kind="Activity" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                  <TextBlock Style="{StaticResource SummaryReadoutStyle}" Text="{Binding HostProcessCountText}" />
                  <TextBlock Style="{StaticResource SummaryReadoutStyle}" Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="{Binding HostThreadCountText}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <controls:HostResourceCharts x:Name="HostCharts" Grid.Row="1" />

          <!-- Detail lists without cards; one structural line separates each column. -->
          <Grid Grid.Row="2" services:LineMotion.Region="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Padding="20,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,1">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <controls:LineIcon Kind="Disk" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                    <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="存储卷" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource SectionCountStyle}" Text="{Binding Drives.Count}" ToolTip="存储卷数量" />
                </Grid>
              </Border>
              <Border Grid.Row="1" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,0" />
                <ItemsControl Grid.Row="1" Margin="0,0,1,0" ItemsSource="{Binding Drives}" Focusable="False" Grid.IsSharedSizeScope="True">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource ResourceRowStyle}">
                        <StackPanel>
                          <controls:MetricHeadingPanel MinHeight="34">
                            <Grid VerticalAlignment="Center">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="DriveLetter" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <TextBlock FontFamily="{StaticResource Semantic.Font.Monospace}" VerticalAlignment="Center" Text="{Binding Name}" />
                              <TextBlock Grid.Column="1" Margin="10,0,12,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Semantic.Font.Monospace}" services:SurfaceMotion.RollingText="{Binding UsedPercent, StringFormat={}{0:0}%}" />
                          </controls:MetricHeadingPanel>
                          <ProgressBar Margin="0,12,0,0" Style="{StaticResource HostMeterStyle}" services:SurfaceMotion.MeterValue="{Binding UsedPercent, Mode=OneWay}" />
                          <TextBlock Style="{StaticResource MetricDetailStyle}" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              <TextBlock Grid.Row="1" Margin="20,16" FontSize="13" Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="暂无存储卷数据" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Drives.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Grid Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Padding="20,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <controls:LineIcon Kind="Network" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                    <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="网络接口" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource SectionCountStyle}" Text="{Binding Networks.Count}" ToolTip="网络接口数量" />
                </Grid>
              </Border>
              <Border Grid.Row="1">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Networks}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource ResourceRowStyle}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" Text="{Binding ReceivedText, StringFormat=↓ {0}}" />
                                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" Text="{Binding SentText, StringFormat=↑ {0}}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  <TextBlock Margin="20,16" FontSize="13" Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="暂无网络接口数据" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Networks.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
        </ScrollViewer>
      </controls:PresencePanel>

      <!-- Aggregated exception logs: list beside the terminal detail. -->
      <controls:PresencePanel x:Name="ExceptionsPage" Grid.Row="0" MotionKind="Page" Background="{DynamicResource Semantic.Brush.WindowBackground}" IsPresented="{Binding IsExceptionLogsPage}">
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="20,0,6,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ExceptionSearchSurface" Height="32" VerticalAlignment="Center" services:FrameHoverAssist.Track="True" BorderBrush="{Binding BorderBrush, ElementName=ExceptionLogSearchBox}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:LineIcon Kind="Search" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                <TextBox x:Name="ExceptionLogSearchBox" Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0" MinHeight="0" Height="30" Padding="2,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center" services:ColorStateAssist.RestingBorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" services:ColorStateAssist.FrameHovered="{Binding Path=(services:FrameHoverAssist.IsInside), ElementName=ExceptionSearchSurface}" AutomationProperties.Name="搜索异常日志" ToolTip="搜索来源、消息或文件 (Ctrl+F)" Text="{Binding ExceptionLogSearchText, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Border>
            <ComboBox Grid.Column="2" Height="32" MinHeight="32" VerticalAlignment="Center" AutomationProperties.Name="异常级别筛选" ItemsSource="{Binding ExceptionLevelFilters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedExceptionLevelFilter}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Width="32" Height="32" Padding="7" VerticalAlignment="Center" Style="{StaticResource DashboardIconButton}" AutomationProperties.Name="打开日志目录" ToolTip="打开日志目录" Command="{Binding OpenLogsCommand}">
              <controls:LineIcon Kind="Folder" Width="16" Height="16" />
            </Button>
            <Border Grid.Column="5" Height="32" VerticalAlignment="Center" Background="{DynamicResource Semantic.Brush.SurfaceInset}" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Padding="12,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,0" ToolTip="异常日志总计">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="总计" FontSize="12" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,-1,6,1" />
                    <TextBlock FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Semantic.Brush.TextPrimary}" VerticalAlignment="Center" Margin="0,-1,0,1" Text="{Binding ExceptionLogCount, StringFormat={}{0} 条}" AutomationProperties.Name="异常日志总计" />
                  </StackPanel>
                </Border>
                <Border Padding="12,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,0" ToolTip="严重级别日志数">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" Background="{DynamicResource Semantic.Brush.StatusCritical}" VerticalAlignment="Center" Margin="0,0,6,0">
                      <Border.Style><Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers><DataTrigger Binding="{Binding CriticalLogCount}" Value="0"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers>
                      </Style></Border.Style>
                    </Border>
                    <TextBlock Text="严重" FontSize="12" VerticalAlignment="Center" Margin="0,-1,6,1">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
                        <Style.Triggers><DataTrigger Binding="{Binding CriticalLogCount}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,-1,0,1" Text="{Binding CriticalLogCount}">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusCritical}" />
                        <Style.Triggers><DataTrigger Binding="{Binding CriticalLogCount}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <Border Padding="12,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,0" ToolTip="错误级别日志数">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" Background="{DynamicResource Semantic.Brush.StatusFailed}" VerticalAlignment="Center" Margin="0,0,6,0">
                      <Border.Style><Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers><DataTrigger Binding="{Binding ErrorLogCount}" Value="0"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers>
                      </Style></Border.Style>
                    </Border>
                    <TextBlock Text="错误" FontSize="12" VerticalAlignment="Center" Margin="0,-1,6,1">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
                        <Style.Triggers><DataTrigger Binding="{Binding ErrorLogCount}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,-1,0,1" Text="{Binding ErrorLogCount}">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
                        <Style.Triggers><DataTrigger Binding="{Binding ErrorLogCount}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <Border Padding="12,0" ToolTip="警告级别日志数">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" Background="{DynamicResource Semantic.Brush.StatusWarning}" VerticalAlignment="Center" Margin="0,0,6,0">
                      <Border.Style><Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers><DataTrigger Binding="{Binding WarningLogCount}" Value="0"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers>
                      </Style></Border.Style>
                    </Border>
                    <TextBlock Text="警告" FontSize="12" VerticalAlignment="Center" Margin="0,-1,6,1">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
                        <Style.Triggers><DataTrigger Binding="{Binding WarningLogCount}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,-1,0,1" Text="{Binding WarningLogCount}">
                      <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusWarning}" />
                        <Style.Triggers><DataTrigger Binding="{Binding WarningLogCount}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" /></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="360" MinWidth="300" MaxWidth="480" />
          </Grid.ColumnDefinitions>
          <Grid>
            <DataGrid ColumnHeaderHeight="44" ItemsSource="{Binding ExceptionLogsView}" SelectedItem="{Binding SelectedExceptionLog}" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent" AutomationProperties.Name="异常日志列表">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Width="124" MinWidth="124" Binding="{Binding TimestampText}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="级别" Width="64" MinWidth="64">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource LogLevelTextStyle}" Text="{Binding LevelLabel}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="来源" Width="0.8*" MinWidth="96" Binding="{Binding Source}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="消息" Width="2.2*" MinWidth="140" Binding="{Binding Message}">
                  <!-- One line per row at every DPI; the full multi-line text stays in the detail pane and tooltip. -->
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="MaxHeight" Value="19" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="ToolTip" Value="{Binding Message}" /></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="文件" Width="1*" MinWidth="88" Binding="{Binding FileName}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="{Binding ExceptionLogEmptyText}" TextWrapping="Wrap" Margin="20" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ExceptionLogCount}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <GridSplitter x:Name="ExceptionDetailsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="True" FocusVisualStyle="{x:Null}" services:ColorStateAssist.Role="Caption" AutomationProperties.Name="调整异常列表与详情宽度">
            <GridSplitter.Style>
              <Style TargetType="GridSplitter">
                <Setter Property="Background" Value="{DynamicResource Semantic.Brush.BorderSubtle}" />
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Semantic.Brush.InteractionHover}" /></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" /></Trigger>
                </Style.Triggers>
              </Style>
            </GridSplitter.Style>
          </GridSplitter>
          <Grid Grid.Column="2" Background="{DynamicResource Semantic.Brush.TerminalBackground}" services:SurfaceMotion.TransitionKey="{Binding SelectedExceptionLog.Entry}">
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border services:LineMotion.Region="0" Padding="20,0" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal">
                <controls:LineIcon Kind="Logs" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                <TextBlock x:Name="ExceptionDetailsCaption" Margin="10,0,0,0" VerticalAlignment="Center" Text="事件详情" Foreground="{Binding Path=(services:ColorStateAssist.CaptionBrush), ElementName=ExceptionDetailsSplitter}" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="20,16,20,8" services:LineMotion.Region="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource InspectorLabelTextStyle}" Text="时间" />
              <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{Binding SelectedExceptionLog.TimestampText}" />
              <TextBlock Grid.Row="1" Style="{StaticResource InspectorLabelTextStyle}" Text="级别" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" DataContext="{Binding SelectedExceptionLog}" Style="{StaticResource LogLevelTextStyle}" Text="{Binding LevelLabel}" />
              <TextBlock Grid.Row="2" Style="{StaticResource InspectorLabelTextStyle}" Text="来源" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{Binding SelectedExceptionLog.Source}" ToolTip="{Binding SelectedExceptionLog.Source}" />
              <TextBlock Grid.Row="3" Style="{StaticResource InspectorLabelTextStyle}" Text="文件" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{Binding SelectedExceptionLog.FileName}" ToolTip="{Binding SelectedExceptionLog.FileName}" />
            </Grid>
            <TextBox x:Name="ExceptionDetailsText" services:LineMotion.Region="2" Grid.Row="2" Margin="20,0,20,20" Padding="12,10" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Semantic.Brush.TerminalBackground}" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" services:ColorStateAssist.RestingBorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="1" VerticalContentAlignment="Top" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="{StaticResource Primitive.Font.12}" Foreground="{DynamicResource Semantic.Brush.TextPrimary}" Text="{Binding SelectedExceptionLog.Message, Mode=OneWay}" />
          </Grid>
        </Grid>
      </controls:PresencePanel>

  </Grid>
</UserControl>

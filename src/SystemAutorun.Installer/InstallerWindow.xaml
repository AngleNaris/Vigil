<Window x:Class="SystemAutorun.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vigil"
        Width="504"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        FocusVisualStyle="{x:Null}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12.5">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressed}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressed}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="0,-1,0,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressed}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceInset}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource ActionPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="0,-1,0,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressed}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="14" Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceInset}"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Viewbox x:Name="CheckMark"
                                         Width="12" Height="12"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource OnAccent}"
                                              Data="M10,17.2 L5,12.2 L6.41,10.79 L10,14.38 L17.59,6.79 L19,8.2 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ContentPresenter Margin="0,-1,0,1" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid Background="{DynamicResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M2.25,2.25 H21.75 V21.75 H2.25 Z M4.5,8.25 H9 M4.5,12.75 H9 M4.5,17.25 H9 M12.75,9 V17.25 H18.75 V9 M15.75,6 V13.5"
                                      Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Miter" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="9,-1,0,1"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"
                                   Text="Vigil" />
                        <TextBlock Margin="6,-1,0,1"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="//" />
                        <TextBlock x:Name="HeaderModeText"
                                   Margin="6,-1,0,1"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="SETUP" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,8,0"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <TextBlock x:Name="VersionBadgeText"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="v1.1.0" />
                        </Border>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                            <Path Width="11" Height="11" Stretch="Uniform" Data="M2,12 H22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                            <Path Width="11" Height="11" Stretch="Uniform" Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,18,20,18">
                <!-- Install Configuration Page -->
                <Border x:Name="ConfigPage"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Border Padding="14,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="{DynamicResource TextMuted}" Text="安装目录" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallDirBox" Style="{StaticResource FlatTextBoxStyle}" AutomationProperties.Name="安装目录" />
                                    <Button x:Name="BrowseInstallButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="68" Content="浏览" Click="BrowseInstall_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="14,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="{DynamicResource TextMuted}" Text="数据目录" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DataDirBox" Style="{StaticResource FlatTextBoxStyle}" AutomationProperties.Name="数据目录" />
                                    <Button x:Name="BrowseDataButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="68" Content="浏览" Click="BrowseData_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="14,12">
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="DesktopShortcutCheck" Style="{StaticResource SquareCheckBoxStyle}" IsChecked="True" Margin="0,0,8,9" Content="桌面快捷方式" />
                                <CheckBox x:Name="StartMenuCheck" Style="{StaticResource SquareCheckBoxStyle}" IsChecked="True" Margin="8,0,0,9" Content="开始菜单快捷方式" />
                                <CheckBox x:Name="AddToPathCheck" Style="{StaticResource SquareCheckBoxStyle}" IsChecked="True" Margin="0,0,8,0" Content="写入 PATH 与 VIGIL_ROOT" />
                                <CheckBox x:Name="LaunchOnStartupCheck" Style="{StaticResource SquareCheckBoxStyle}" IsChecked="True" Margin="8,0,0,0" Content="开机自动启动" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Uninstall Configuration Page -->
                <Border x:Name="UninstallPage"
                        Visibility="Collapsed"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Border Padding="14,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Text="目标路径" />
                                <TextBlock x:Name="UninstallPathText" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Padding="14,12">
                            <CheckBox x:Name="RemoveDataCheck" Style="{StaticResource SquareCheckBoxStyle}" IsChecked="False" Content="同时删除数据目录" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Progress Page -->
                <Border x:Name="ProgressPage"
                        Visibility="Collapsed"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        Padding="16,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressStepText" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Text="正在部署…" />
                            <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Margin="12,0,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Accent}" Text="0%" />
                        </Grid>
                        <Border x:Name="ProgressTrack" Height="2" Margin="0,10,0,0" Background="{DynamicResource Border}">
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource Accent}" />
                        </Border>
                        <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource SurfaceInset}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <TextBlock x:Name="ProgressLogText"
                                       MinHeight="72"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Done Page -->
                <Border x:Name="DonePage"
                        Visibility="Collapsed"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DoneTitleText"
                                       Margin="9,-1,0,1"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Text="安装完成" />
                        </StackPanel>

                        <Border Margin="0,12,0,0"
                                Background="{DynamicResource SurfaceInset}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Padding="12,9" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DoneLocationLabel" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Text="安装位置" />
                                        <TextBlock x:Name="DoneInstallDirText" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border x:Name="DoneCliRow" Padding="12,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DoneCliLabel" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Text="CLI 命令" />
                                        <TextBlock x:Name="DoneCliHintText" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Text="vigil status" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="LaunchNowCheck"
                                  Margin="0,12,0,0"
                                  Style="{StaticResource SquareCheckBoxStyle}"
                                  IsChecked="True"
                                  Content="立即启动 Vigil" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="20,0">
                <UniformGrid x:Name="FooterButtonGrid"
                             Rows="1"
                             Columns="2"
                             Margin="-4,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="4,0"
                            HorizontalAlignment="Stretch"
                            Content="取消"
                            Click="Cancel_Click" />
                    <Button x:Name="PrimaryActionButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="4,0"
                            HorizontalAlignment="Stretch"
                            Content="安装"
                            Click="PrimaryAction_Click" />
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>

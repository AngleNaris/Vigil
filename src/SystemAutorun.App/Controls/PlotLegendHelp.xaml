<UserControl x:Class="SystemAutorun.App.Controls.PlotLegendHelp" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SystemAutorun.App.Controls" VerticalAlignment="Center" Focusable="False">
  <Grid VerticalAlignment="Center">
    <Button x:Name="HelpButton" Style="{StaticResource DashboardIconButton}" Width="22" Height="22" Padding="3" VerticalAlignment="Center"
            Click="Help_Click" PreviewKeyDown="Help_PreviewKeyDown"
            AutomationProperties.Name="{Binding AccessibleName, ElementName=Root}" ToolTip="{Binding AccessibleName, ElementName=Root}">
      <controls:LineIcon Kind="LegendHelp" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Button>
    <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" StaysOpen="False" Focusable="False">
      <Border x:Name="HelpContent" HorizontalAlignment="Left" Background="{DynamicResource Semantic.Brush.WindowBackground}" BorderBrush="{DynamicResource Semantic.Brush.BorderStrong}" BorderThickness="1" Padding="12">
        <StackPanel>
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Legend}" Value="Health"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
              <Border Width="10" Height="10" VerticalAlignment="Center" Background="{DynamicResource Semantic.Brush.Selection}" ClipToBounds="True"><Path Stroke="{DynamicResource Semantic.Brush.BorderStrong}" StrokeThickness="1" Data="M0,6 L10,0 M0,14 L10,8" /></Border>
              <TextBlock Text="未知" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Border Width="10" Height="10" VerticalAlignment="Center" Background="{DynamicResource Semantic.Brush.HistoryHealthy}" /><TextBlock Text="正常" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" /></StackPanel>
            <StackPanel Orientation="Horizontal"><Border Width="10" Height="10" VerticalAlignment="Center" Background="{DynamicResource Semantic.Brush.StatusFailed}" /><TextBlock Text="故障" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" /></StackPanel>
          </StackPanel>
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Legend}" Value="Disk"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Legend}" Value="Network"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
              <Border Width="18" Height="2" Background="{DynamicResource Semantic.Brush.Accent}" VerticalAlignment="Center" /><controls:LineIcon Kind="Inbound" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.Accent}" />
              <TextBlock Text="{Binding PrimaryName}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="18" Height="2" Background="{DynamicResource Semantic.Brush.ChartSecondary}" VerticalAlignment="Center" /><controls:LineIcon Kind="Outbound" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.ChartSecondary}" />
              <TextBlock Text="{Binding SecondaryName}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>

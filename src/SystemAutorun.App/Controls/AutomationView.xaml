<UserControl x:Class="SystemAutorun.App.Controls.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
             xmlns:services="clr-namespace:SystemAutorun.App.Services"
             Background="{DynamicResource Semantic.Brush.WindowBackground}"
             Foreground="{DynamicResource Semantic.Brush.TextPrimary}"
             TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}"
             FontFamily="{StaticResource Semantic.Font.Interface}"
             FontSize="13">
    <UserControl.Resources>
        <Style x:Key="AutomationHeaderAction" TargetType="Button" BasedOn="{StaticResource DashboardIconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style x:Key="AutomationRowBadge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextHint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Monospace}" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabledRule}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AutomationRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".3*" MinWidth="240" MaxWidth="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Collapsible Rule Sidebar (exact match to ServicesPage) -->
        <Border BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
                    <DockPanel>
                        <Button x:Name="AddRuleMenuButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource DashboardIconButton}"
                                Width="32"
                                Height="32"
                                Padding="8"
                                VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AutomationRoot, Path=(services:SidebarAssist.ExpandedVisibility)}"
                                Click="AddRuleMenuButton_Click"
                                ToolTip="添加自动化规则或预设"
                                AutomationProperties.Name="添加自动化规则">
                            <controls:LineIcon Kind="Plus" Width="16" Height="16" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AddRuleContextMenu">
                                    <MenuItem Header="新建自定义进程规则…" Click="AddCustomRule_Click" />
                                    <MenuItem x:Name="AddFromTaskMenuItem" Header="从已纳管服务创建" />
                                    <Separator />
                                    <MenuItem Header="预设：桌面合成器 (dwm.exe)" Tag="dwm-compositor" Click="AddPreset_Click" />
                                    <MenuItem Header="预设：僵尸资源管理器 (explorer /factory)" Tag="explorer-factory-zombies" Click="AddPreset_Click" />
                                    <MenuItem Header="预设：Directory Opus (dopus.exe)" Tag="dopus-handles" Click="AddPreset_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ToggleSidebarButton"
                                    Style="{StaticResource DashboardIconButton}"
                                    Width="32"
                                    Height="32"
                                    Padding="8"
                                    VerticalAlignment="Center"
                                    Command="{x:Static services:SidebarAssist.ToggleCommand}"
                                    CommandParameter="{Binding ElementName=AutomationRoot}"
                                    ToolTip="折叠或展开规则列表"
                                    AutomationProperties.Name="折叠或展开规则列表">
                                <controls:LineIcon Kind="Menu" Width="16" Height="16" />
                            </Button>
                            <TextBlock x:Name="RuleCountText"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular"
                                       Visibility="{Binding ElementName=AutomationRoot, Path=(services:SidebarAssist.ExpandedVisibility)}"
                                       Text="0条规则" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Button Grid.Row="1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        Style="{StaticResource DashboardIconButton}"
                        Visibility="{Binding ElementName=AutomationRoot, Path=(services:SidebarAssist.CollapsedVisibility)}"
                        Click="AddRuleMenuButton_Click"
                        ToolTip="添加自动化规则或预设"
                        AutomationProperties.Name="添加自动化规则">
                    <controls:LineIcon Kind="Plus" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建自定义进程规则…" Click="AddCustomRule_Click" />
                            <Separator />
                            <MenuItem Header="预设：桌面合成器 (dwm.exe)" Tag="dwm-compositor" Click="AddPreset_Click" />
                            <MenuItem Header="预设：僵尸资源管理器 (explorer /factory)" Tag="explorer-factory-zombies" Click="AddPreset_Click" />
                            <MenuItem Header="预设：Directory Opus (dopus.exe)" Tag="dopus-handles" Click="AddPreset_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <ListBox x:Name="RuleList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         Visibility="{Binding ElementName=AutomationRoot, Path=(services:SidebarAssist.ExpandedVisibility)}"
                         ItemContainerStyle="{StaticResource DashboardServiceItem}"
                         SelectionChanged="RuleList_SelectionChanged"
                         MouseDoubleClick="RuleList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="RuleList_PreviewMouseRightButtonDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         KeyboardNavigation.TabNavigation="Once"
                         AutomationProperties.Name="自动化规则列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Summary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,10,0"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LineIcon Kind="Warning"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,5,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding AlertVisibility}"
                                                       Foreground="{DynamicResource Semantic.Brush.StatusWarning}" />
                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource AutomationRowBadge}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="ContextToggleAutoItem" Header="启用/停用自动触发" Click="ToggleAuto_Click" />
                            <MenuItem Header="立即执行一次" Click="RunOnce_Click" />
                            <Separator />
                            <MenuItem Header="编辑规则设置…" Click="EditRule_Click" />
                            <Separator />
                            <MenuItem Header="删除规则" Click="DeleteRule_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <Grid Grid.Row="1"
                      IsHitTestVisible="False"
                      Visibility="{Binding ElementName=AutomationRoot, Path=(services:SidebarAssist.ExpandedVisibility)}">
                    <TextBlock x:Name="SidebarEmptyText"
                               Margin="22,24"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource Semantic.Brush.TextHint}"
                               TextWrapping="Wrap"
                               Text="暂无自动化规则" />
                </Grid>
            </Grid>
        </Border>

        <!-- Right Pure-Telemetry Dashboard Canvas (matches ServicesPage geometry, plots & motion) -->
        <Grid x:Name="RuleDetailSurface" Grid.Column="1">
            <!-- Active Rule Telemetry View -->
            <Grid x:Name="RuleDashboardGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="128" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Compact Header Bar (54px, exact match to ServiceHeader) -->
                <Border services:LineMotion.Region="0"
                        MinHeight="54"
                        Padding="6,8,6,8"
                        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                        BorderThickness="0,0,0,1">
                    <Grid x:Name="RuleHeader" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Height="28"
                                Style="{StaticResource InteractiveFrameBorderStyle}"
                                BorderThickness="1"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <controls:LineIcon x:Name="HeaderIcon"
                                               Kind="Windows"
                                               Width="15"
                                               Height="15"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitleText"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HeaderRuleSummaryText"
                                       FontSize="11"
                                       Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Clear Control 1: Auto-Trigger Switch (ON/OFF background watching, does NOT run immediately) -->
                        <Border x:Name="AutoToggleBorder"
                                Grid.Column="2"
                                Height="32"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource InteractiveFrameBorderStyle}"
                                BorderThickness="1">
                            <Button x:Name="AutoToggleButton"
                                    Style="{StaticResource DashboardHeaderChoice}"
                                    Click="ToggleAuto_Click"
                                    ToolTip="开关后台自动触发：开启后按定时或资源阈值自动巡检重启；点击此开关不会立刻重启进程"
                                    AutomationProperties.Name="切换自动触发开关">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LineIcon x:Name="AutoToggleIcon"
                                                       Kind="Pause"
                                                       Width="13"
                                                       Height="13"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                    <TextBlock x:Name="AutoToggleText"
                                               VerticalAlignment="Center"
                                               Text="自动：已停用" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Clear Control 2: One-Shot Immediate Run (runs once right now, does NOT toggle auto state) -->
                        <Border x:Name="RunOnceBorder"
                                Grid.Column="3"
                                Height="32"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource InteractiveFrameBorderStyle}"
                                BorderThickness="1">
                            <Button x:Name="RunOnceButton"
                                    Style="{StaticResource DashboardHeaderChoice}"
                                    Click="RunOnce_Click"
                                    ToolTip="手动立即执行一次重启操作，不改变规则当前的自动触发启停状态"
                                    AutomationProperties.Name="立即执行一次">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LineIcon Kind="Restart"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="立即执行一次" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Control 3: More menu (rule settings live inside this menu or double-click on sidebar, no duplicate gear icon) -->
                        <Border x:Name="RuleActionsBorder"
                                Grid.Column="4"
                                Height="32"
                                VerticalAlignment="Center"
                                Style="{StaticResource InteractiveFrameBorderStyle}"
                                BorderThickness="1">
                            <Button x:Name="RuleMoreButton"
                                    Style="{StaticResource AutomationHeaderAction}"
                                    Click="MoreMenu_Click"
                                    ToolTip="规则设置与更多操作"
                                    AutomationProperties.Name="规则设置与更多操作">
                                <controls:LineIcon Kind="More" />
                                <Button.ContextMenu>
                                    <ContextMenu Opened="RuleMoreMenu_Opened">
                                        <MenuItem Header="编辑规则设置…" Click="EditRule_Click" />
                                        <MenuItem Header="立即执行一次" Click="RunOnce_Click" />
                                        <MenuItem x:Name="MoreToggleAutoMenuItem" Header="启用自动触发" Click="ToggleAuto_Click" />
                                        <Separator />
                                        <MenuItem x:Name="MoreGlobalWatchMenuItem"
                                                  Header="后台全局巡检总开关"
                                                  IsCheckable="True"
                                                  Click="ToggleGlobalWatch_Click" />
                                        <MenuItem x:Name="MoreMaintenanceMenuItem"
                                                  Header="提权维护通道…"
                                                  Click="MaintenanceAction_Click" />
                                        <Separator />
                                        <MenuItem Header="删除规则" Click="DeleteRule_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Rule Observation & Trigger Timeline Strip (exact match to Service Health strip) -->
                <Grid Grid.Row="1" Margin="6,10,6,10" services:LineMotion.Region="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LineIcon Kind="Activity" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                        <TextBlock Margin="16,0,0,0" Text="巡检态" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                        <TextBlock x:Name="StateReadoutText"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Text="未采样" />
                        <TextBlock x:Name="LastResultNoticeText"
                                   Margin="12,0,0,0"
                                   MaxWidth="420"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="6,8,6,0" Style="{StaticResource InteractiveFrameBorderStyle}" BorderThickness="1">
                        <controls:DashboardPlot x:Name="RuleHealthPlot"
                                                Mode="Health"
                                                WindowHours="0"
                                                AutomationProperties.Name="自动化巡检与阈值触发时间带" />
                    </Border>
                </Grid>

                <!-- Row 2: 2x2 Sleek Animated Telemetry Grid (CPU+Peak, Memory+Peak, Handles+Peak, Inactive Handles+Peak) -->
                <ScrollViewer x:Name="RuleMetricsScroll"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Padding="0">
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           HorizontalAlignment="Right"
                                           Orientation="Vertical"
                                           Minimum="0"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cell (0,0): CPU & Peak -->
                        <Border x:Name="CpuCell"
                                Grid.Row="0"
                                Grid.Column="0"
                                services:LineMotion.Region="2"
                                Style="{StaticResource DashboardMetricCell}"
                                Padding="6,10,10,8"
                                BorderThickness="0,0,1,1"
                                AutomationProperties.Name="目标进程CPU与峰值">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:MetricHeadingPanel MinHeight="30" Margin="0,0,0,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Style="{StaticResource InteractiveFrameBorderStyle}" Background="Transparent" BorderThickness="1" VerticalAlignment="Center">
                                            <controls:LineIcon Kind="Cpu" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="CPU" />
                                        <TextBlock x:Name="CpuPeakText"
                                                   Margin="10,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontSize="{StaticResource Primitive.Font.12}"
                                                   Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                                   Text="峰值 --" />
                                    </StackPanel>
                                    <TextBlock x:Name="CpuReadout"
                                               Style="{StaticResource DashboardReadout}"
                                               FontSize="22"
                                               Text="--"
                                               AutomationProperties.Name="当前CPU占用" />
                                </controls:MetricHeadingPanel>
                                <controls:DashboardPlot x:Name="CpuPlot"
                                                        Grid.Row="1"
                                                        Height="118"
                                                        PlotLeftInset="0.5"
                                                        PlotRightInset="0.5"
                                                        EmptyText="等待采样…"
                                                        AutomationProperties.Name="CPU趋势与阈值" />
                            </Grid>
                        </Border>

                        <!-- Cell (0,1): Memory & Peak -->
                        <Border x:Name="MemoryCell"
                                Grid.Row="0"
                                Grid.Column="1"
                                services:LineMotion.Region="3"
                                Style="{StaticResource DashboardMetricCell}"
                                Padding="10,10,6,8"
                                BorderThickness="0,0,0,1"
                                AutomationProperties.Name="目标进程内存与峰值">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:MetricHeadingPanel MinHeight="30" Margin="0,0,0,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Style="{StaticResource InteractiveFrameBorderStyle}" Background="Transparent" BorderThickness="1" VerticalAlignment="Center">
                                            <controls:LineIcon Kind="Memory" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="内存" />
                                        <TextBlock x:Name="MemoryPeakText"
                                                   Margin="10,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontSize="{StaticResource Primitive.Font.12}"
                                                   Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                                   Text="峰值 --" />
                                    </StackPanel>
                                    <TextBlock x:Name="MemoryReadout"
                                               Style="{StaticResource DashboardReadout}"
                                               FontSize="22"
                                               Text="--"
                                               AutomationProperties.Name="当前内存工作集" />
                                </controls:MetricHeadingPanel>
                                <controls:DashboardPlot x:Name="MemoryPlot"
                                                        Grid.Row="1"
                                                        Height="118"
                                                        PlotLeftInset="0.5"
                                                        PlotRightInset="0.5"
                                                        Bytes="True"
                                                        EmptyText="等待采样…"
                                                        AutomationProperties.Name="内存趋势与阈值" />
                            </Grid>
                        </Border>

                        <!-- Cell (1,0): Total Handles & Peak + GDI/USER -->
                        <Border x:Name="HandlesCell"
                                Grid.Row="1"
                                Grid.Column="0"
                                services:LineMotion.Region="4"
                                Style="{StaticResource DashboardMetricCell}"
                                Padding="6,10,10,8"
                                BorderThickness="0,0,1,0"
                                AutomationProperties.Name="总句柄与峰值">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:MetricHeadingPanel MinHeight="30" Margin="0,0,0,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Style="{StaticResource InteractiveFrameBorderStyle}" Background="Transparent" BorderThickness="1" VerticalAlignment="Center">
                                            <controls:LineIcon Kind="Service" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="句柄" />
                                        <TextBlock x:Name="HandlesPeakText"
                                                   Margin="10,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontSize="{StaticResource Primitive.Font.12}"
                                                   Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                                   Text="峰值 --" />
                                    </StackPanel>
                                    <TextBlock x:Name="HandlesReadout"
                                               Style="{StaticResource DashboardReadout}"
                                               FontSize="22"
                                               Text="--"
                                               AutomationProperties.Name="当前句柄总数" />
                                </controls:MetricHeadingPanel>
                                <controls:DashboardPlot x:Name="HandlesPlot"
                                                        Grid.Row="1"
                                                        Height="118"
                                                        PlotLeftInset="0.5"
                                                        PlotRightInset="0.5"
                                                        Count="True"
                                                        EmptyText="等待采样…"
                                                        AutomationProperties.Name="句柄数趋势与阈值" />
                            </Grid>
                        </Border>

                        <!-- Cell (1,1): Inactive / Stale Handles & Peak -->
                        <Border x:Name="InactiveHandlesCell"
                                Grid.Row="1"
                                Grid.Column="1"
                                services:LineMotion.Region="5"
                                Style="{StaticResource DashboardMetricCell}"
                                Padding="10,10,6,8"
                                BorderThickness="0"
                                AutomationProperties.Name="不活跃句柄与峰值">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:MetricHeadingPanel MinHeight="30" Margin="0,0,0,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Style="{StaticResource InteractiveFrameBorderStyle}" Background="Transparent" BorderThickness="1" VerticalAlignment="Center">
                                            <controls:LineIcon Kind="Clock" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="不活跃句柄" />
                                        <TextBlock x:Name="InactiveHandlesPeakText"
                                                   Margin="10,1,0,0"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"
                                                   FontSize="{StaticResource Primitive.Font.12}"
                                                   Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                                   Text="峰值 --" />
                                    </StackPanel>
                                    <TextBlock x:Name="InactiveHandlesReadout"
                                               Style="{StaticResource DashboardReadout}"
                                               FontSize="22"
                                               Text="--"
                                               AutomationProperties.Name="当前不活跃句柄数" />
                                </controls:MetricHeadingPanel>
                                <controls:DashboardPlot x:Name="InactiveHandlesPlot"
                                                        Grid.Row="1"
                                                        Height="118"
                                                        PlotLeftInset="0.5"
                                                        PlotRightInset="0.5"
                                                        Count="True"
                                                        EmptyText="等待采样…"
                                                        AutomationProperties.Name="不活跃句柄趋势与阈值" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Empty State (no rules configured) -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="440">
                <TextBlock Text="暂无自动化规则" FontSize="17" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,20"
                           Foreground="{DynamicResource Semantic.Brush.TextHint}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="监控进程峰值与不活跃句柄，并按定时或持续超标自动重启。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ImportPresetsButton"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Padding="16,0"
                            Content="导入推荐预设"
                            Click="ImportAllPresets_Click"
                            AutomationProperties.Name="导入推荐自动化预设" />
                    <Button x:Name="EmptyAddRuleButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Padding="16,0"
                            Content="新建自定义规则"
                            Click="AddCustomRule_Click"
                            AutomationProperties.Name="新建自定义自动化规则" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

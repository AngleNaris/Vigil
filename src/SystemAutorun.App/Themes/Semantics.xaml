<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Semantic.Brush.WindowBackground"
                     Color="{StaticResource Primitive.Color.Background.950}" />
    <SolidColorBrush x:Key="Semantic.Brush.SurfacePrimary"
                     Color="{StaticResource Primitive.Color.Surface.800}" />
    <SolidColorBrush x:Key="Semantic.Brush.SurfaceInset"
                     Color="{StaticResource Primitive.Color.Surface.850}" />
    <SolidColorBrush x:Key="Semantic.Brush.SurfaceHover"
                     Color="{StaticResource Primitive.Color.Surface.700}" />
    <SolidColorBrush x:Key="Semantic.Brush.BorderStrong"
                     Color="{StaticResource Primitive.Color.Border.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.BorderSubtle"
                     Color="{StaticResource Primitive.Color.Border.700}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextPrimary"
                     Color="{StaticResource Primitive.Color.Text.100}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextSecondary"
                     Color="{StaticResource Primitive.Color.Text.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextHint"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextDisabled"
                     Color="{StaticResource Primitive.Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Semantic.Brush.ActionPrimary"
                     Color="{StaticResource Primitive.Color.Action.Default}" />
    <SolidColorBrush x:Key="Semantic.Brush.ActionPrimaryHover"
                     Color="{StaticResource Primitive.Color.Action.Hover}" />
    <SolidColorBrush x:Key="Semantic.Brush.FocusAccent"
                     Color="{StaticResource Primitive.Color.Action.Focus}" />
    <!-- R105: dims the main window while one of its tool dialogs is open, so the child reads as a child. -->
    <SolidColorBrush x:Key="Semantic.Brush.Scrim" Color="#141417" Opacity="0.68" />
    <SolidColorBrush x:Key="Semantic.Brush.Selection"
                     Color="{StaticResource Primitive.Color.Selection}" />
    <!-- R104b: focus never dims text. Rest sits at the icon-role grey so focus can brighten by 3.24:1. -->
    <SolidColorBrush x:Key="Semantic.Brush.InteractionHover" Color="{StaticResource Primitive.Color.Interaction.DarkHover}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionOnHover" Color="{StaticResource Primitive.Color.OnStatus}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionActive" Color="{StaticResource Primitive.Color.Interaction.DarkActiveSurface}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionActiveHover" Color="{StaticResource Primitive.Color.Interaction.DarkActiveHover}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionOnActive" Color="{StaticResource Primitive.Color.Interaction.DarkOnActive}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionRest"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionFocus"
                     Color="{StaticResource Primitive.Color.Text.Bright}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionSelected"
                     Color="{StaticResource Primitive.Color.Text.Bright}" />
    <SolidColorBrush x:Key="Semantic.Brush.InteractionSelectedFocus"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <!-- R104 state contrast: selection is brighter than rest; focus changes an existing line or glyph color. -->
    <SolidColorBrush x:Key="Semantic.Brush.RowRest"
                     Color="{StaticResource Primitive.Color.Text.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.RowSelected"
                     Color="{StaticResource Primitive.Color.Text.Bright}" />
    <SolidColorBrush x:Key="Semantic.Brush.RowMuted"
                     Color="{StaticResource Primitive.Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Semantic.Brush.RowMutedSelected"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.RowFocusBorder"
                     Color="{StaticResource Primitive.Color.Border.700}" />
    <SolidColorBrush x:Key="Semantic.Brush.Accent"
                     Color="{StaticResource Primitive.Color.Error.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.IconRest"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.IconFocus"
                     Color="{StaticResource Primitive.Color.Text.Bright}" />
    <SolidColorBrush x:Key="Semantic.Brush.ToggleSelected"
                     Color="{StaticResource Primitive.Color.Primary.Foreground}" />
    <SolidColorBrush x:Key="Semantic.Brush.ToggleSelectedFocus"
                     Color="{StaticResource Primitive.Color.Focus.OnLight}" />
    <SolidColorBrush x:Key="Semantic.Brush.ToggleSelectedSurface"
                     Color="{StaticResource Primitive.Color.Text.Bright}" />
    <SolidColorBrush x:Key="Semantic.Brush.FocusBorderOnLight"
                     Color="{StaticResource Primitive.Color.Focus.OnLight}" />
    <SolidColorBrush x:Key="Semantic.Brush.ActionPrimaryPressed"
                     Color="{StaticResource Primitive.Color.Action.Pressed}" />
    <SolidColorBrush x:Key="Semantic.Brush.PrimaryForeground"
                     Color="{StaticResource Primitive.Color.Primary.Foreground}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusHealthy"
                     Color="{StaticResource Primitive.Color.Success.400}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusFailed"
                     Color="{StaticResource Primitive.Color.Error.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusDisabled"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusWarning"
                     Color="{StaticResource Primitive.Color.Warning.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusCritical"
                     Color="{StaticResource Primitive.Color.Critical.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.OnStatus" Color="{StaticResource Primitive.Color.OnStatus}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusInfo"
                     Color="{StaticResource Primitive.Color.Info.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.TerminalBackground"
                     Color="{StaticResource Primitive.Color.Terminal.950}" />
    <SolidColorBrush x:Key="Semantic.Brush.ChartSecondary"
                     Color="{StaticResource Primitive.Color.Chart.SecondaryDark}" />
    <SolidColorBrush x:Key="Semantic.Brush.HistoryHealthy"
                     Color="{StaticResource Primitive.Color.History.Healthy}" />
    <SolidColorBrush x:Key="Semantic.Brush.DangerHover"
                     Color="{StaticResource Primitive.Color.Error.Surface}" />
</ResourceDictionary>

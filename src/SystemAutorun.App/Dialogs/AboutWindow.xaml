<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.AboutWindow"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 Vigil"
        Width="504"
        MinWidth="440"
        SizeToContent="Height"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
        <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}"
              TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource DialogHeaderBorderStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource DashboardIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="关闭" AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <controls:LineIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:LineIcon Style="{StaticResource DialogHeaderIconStyle}"
                                           Foreground="{DynamicResource Semantic.Brush.Accent}"
                                           Kind="Brand" />
                        <TextBlock x:Name="DialogTitleText"
                                   Grid.Column="1"
                                   Style="{StaticResource DialogTitleTextStyle}"
                                   Text="关于 Vigil" />
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,18">
                <Border Padding="16,14"
                        Background="{DynamicResource Semantic.Brush.SurfacePrimary}"
                        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                Background="#0B0B0D"
                                BorderBrush="{DynamicResource Semantic.Brush.Accent}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <controls:LineIcon Width="22"
                                               Height="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Semantic.Brush.Accent}"
                                               Kind="Brand" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center">
                                    <Border Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            BorderBrush="{DynamicResource Semantic.Brush.Accent}" BorderThickness="1.5,1.5,0,0"
                                            Opacity="0.85" IsHitTestVisible="False" />
                                    <Border Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            BorderBrush="{DynamicResource Semantic.Brush.Accent}" BorderThickness="0,0,1.5,1.5"
                                            Opacity="0.85" IsHitTestVisible="False" />
                                    <TextBlock Margin="7.5,2.5,4.5,0.5"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Semantic.Font.Monospace}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Semantic.Brush.Accent}"
                                               Opacity="0.22"
                                               IsHitTestVisible="False"
                                               Text="Vigil" />
                                    <TextBlock Margin="6,1,6,2"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Semantic.Font.Monospace}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Semantic.Brush.Accent}"
                                               Text="Vigil" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False">
                                    <Rectangle Width="3" Height="11" Fill="{DynamicResource Semantic.Brush.Accent}" Opacity="0.88">
                                        <Rectangle.RenderTransform><SkewTransform AngleX="-20" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2" Height="11" Margin="3,0,0,0" Fill="{DynamicResource Semantic.Brush.Accent}" Opacity="0.38">
                                        <Rectangle.RenderTransform><SkewTransform AngleX="-20" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                </StackPanel>
                                <Border Margin="10,0,0,0"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Semantic.Brush.SurfaceInset}"
                                        BorderBrush="{DynamicResource Semantic.Brush.Accent}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="VersionValueText"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontFamily="{StaticResource Semantic.Font.Monospace}"
                                               Foreground="{DynamicResource Semantic.Brush.Accent}"
                                               AutomationProperties.Name="当前版本" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource DetailTextStyle}"
                                       Text="Windows 家庭服务器监控与自启控制台"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="OpenRepoButton"
                                Grid.Column="2"
                                Height="32"
                                MinWidth="104"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.Name="打开项目主页"
                                Click="OpenRepo_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:LineIcon Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Kind="Code" />
                                <TextBlock x:Name="OpenRepoLabel" Margin="0,-1,0,1" VerticalAlignment="Center" Text="项目主页" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Background="{DynamicResource Semantic.Brush.SurfaceInset}"
                        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                        BorderThickness="1">
                    <StackPanel>
                        <Border Padding="16,10"
                                BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource PropertyLabelTextStyle}" Text="作者" />
                                <TextBlock x:Name="AuthorValueText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="作者" />
                            </Grid>
                        </Border>

                        <Border Padding="16,10"
                                BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource PropertyLabelTextStyle}" Text="技术架构" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource DetailTextStyle}"
                                           Text=".NET 10 / WPF / Named Pipe Agent" />
                            </Grid>
                        </Border>

                        <Border Padding="16,10"
                                Background="{DynamicResource Semantic.Brush.SurfacePrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,2,0,0" VerticalAlignment="Top" Style="{StaticResource PropertyLabelTextStyle}" Text="更新状态" />
                                <TextBlock x:Name="UpdateStatusText"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource DetailTextStyle}"
                                           AutomationProperties.Name="更新检查状态"
                                           Text="点击“检查更新”查询 GitHub Releases 最新版本。" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource DialogFooterBorderStyle}">
                <UniformGrid Style="{StaticResource DialogActionsStyle}">
                    <Button Margin="4,0"
                            Style="{StaticResource DialogButtonStyle}"
                            IsCancel="True">
                        <TextBlock Margin="0,-1,0,1" VerticalAlignment="Center" Text="关闭" />
                    </Button>
                    <Button x:Name="CheckUpdateButton"
                            Margin="4,0"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            AutomationProperties.Name="检查更新"
                            IsDefault="True"
                            Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:LineIcon Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Kind="Refresh" />
                            <TextBlock x:Name="CheckUpdateLabel" Margin="0,-1,0,1" Text="检查更新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

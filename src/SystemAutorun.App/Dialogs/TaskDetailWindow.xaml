<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.TaskDetailWindow"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vigil"
        Width="680"
        Height="480"
        MinWidth="580"
        MinHeight="400"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
    <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}"
          TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DialogHeaderBorderStyle}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DashboardIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                        ToolTip="关闭" AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:LineIcon Kind="Close" Width="15" Height="15" />
                </Button>                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:LineIcon Style="{StaticResource DialogHeaderIconStyle}"
                                             Kind="Info" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource DialogTitleTextStyle}"
                               Text="{Binding Task.Name}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="20,14"
                BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabelTextStyle}" Text="健康状态" />
                <TextBlock Grid.Column="1" Text="{Binding Health.Reason}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Style="{StaticResource PropertyLabelTextStyle}" Text="进程 PID" />
                <TextBlock x:Name="ProcessText" Grid.Column="4" />
                <TextBlock Grid.Row="2" Style="{StaticResource PropertyLabelTextStyle}" Text="启动模式" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Task.Launch}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropertyLabelTextStyle}" Text="状态详情" />
                <TextBlock Grid.Row="2"
                           Grid.Column="4"
                           Text="{Binding Health.Detail}"
                           TextWrapping="Wrap"
                           ToolTip="{Binding Health.Detail}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,14,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <controls:LineIcon Width="16"
                                         Height="16"
                                         Margin="0,0,7,0"
                                         Foreground="{DynamicResource Semantic.Brush.TextSecondary}"
                                         Kind="Terminal" />
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="最近日志" />
            </StackPanel>
            <TextBox x:Name="LogsText"
                     Grid.Row="2"
                     Style="{StaticResource LogTextBoxStyle}"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource DialogFooterBorderStyle}">
            <UniformGrid Style="{StaticResource DialogActionsStyle}">
                <Button Margin="4,0" AutomationProperties.Name="关闭任务详情"
                        Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="Close_Click" Content="关闭" />
            </UniformGrid>
        </Border>
    </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

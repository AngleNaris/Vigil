<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="Semantic.Font.Interface">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Semantic.Font.Monospace">Cascadia Code, Consolas</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Semantic.Font.Interface}" />
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.13}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="PageTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.24}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextHint}" />
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
    </Style>

    <Style x:Key="SectionTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.14}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="PanelTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.16}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HintTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextHint}" />
    </Style>

    <Style x:Key="DetailTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfacePrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfacePrimary}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource Semantic.Brush.SurfaceHover}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.ActionPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.FocusAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource Semantic.Brush.SurfaceInset}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.BorderSubtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.ActionPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.PrimaryForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.ActionPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Semantic.Brush.ActionPrimaryHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.FocusAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="BorderThickness" Value="3,1,1,1" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style x:Key="PanelPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.FocusAccent}" />
        <Setter Property="BorderThickness" Value="3,1,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PanelDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelActionButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusFailed}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusFailed}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Semantic.Brush.DangerHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusFailed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
    </Style>

    <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <Style x:Key="IconToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="InspectorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelActionButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="InspectorPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPrimaryButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="InspectorDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelDangerButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="MetricValueTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.16}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="MetricLabelTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.11}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.FocusAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      ClickMode="Press"
                                      Focusable="False"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              RecognizesAccessKey="True" />
                                            <Path Grid.Column="1"
                                                  Width="8"
                                                  Height="4"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource Semantic.Brush.TextSecondary}"
                                                  StrokeThickness="1.4" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder"
                                                    Property="Background"
                                                    Value="{StaticResource Semantic.Brush.SurfaceHover}" />
                                            <Setter TargetName="ToggleBorder"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource Semantic.Brush.ActionPrimary}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource Semantic.Brush.FocusAccent}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ToggleBorder"
                                                    Property="Background"
                                                    Value="{StaticResource Semantic.Brush.SurfaceInset}" />
                                            <Setter TargetName="ToggleBorder"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource Semantic.Brush.BorderSubtle}" />
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Semantic.Brush.TextDisabled}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="SelectedContent"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource Semantic.Brush.SurfaceInset}"
                                    BorderBrush="{StaticResource Semantic.Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <ScrollViewer Margin="0,2"
                                              CanContentScroll="True"
                                              SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DropDownToggle"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.FocusAccent}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="MinHeight" Value="32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Semantic.Brush.BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Semantic.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Semantic.Brush.Selection}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource Semantic.Brush.FocusAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{StaticResource Semantic.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder"
                                Width="16"
                                Height="16"
                                Background="{StaticResource Semantic.Brush.SurfaceInset}"
                                BorderBrush="{StaticResource Semantic.Brush.BorderStrong}"
                                BorderThickness="1">
                            <Path x:Name="CheckMark"
                                  Width="9"
                                  Height="7"
                                  Data="M 0 3.5 L 3 6.5 L 9 0"
                                  Stroke="{StaticResource Semantic.Brush.PrimaryForeground}"
                                  StrokeThickness="1.8"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.FocusAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource Semantic.Brush.ActionPrimary}" />
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.FocusAccent}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource Semantic.Brush.BorderSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfacePrimary}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="RowBackground" Value="{StaticResource Semantic.Brush.SurfacePrimary}" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Semantic.Brush.Selection}" />
                <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Semantic.Brush.Selection}" />
                <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,9" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{StaticResource Primitive.Font.12}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="BusyProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.FocusAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Semantic.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.TextHint}" />
        <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</ResourceDictionary>

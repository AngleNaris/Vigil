<Window x:Class="SystemAutorun.App.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SystemAutorun"
        Width="520"
        SizeToContent="Height"
        MaxHeight="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource CardBorderStyle}" Margin="14" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PanelTitleTextStyle}" />
            <TextBlock x:Name="BodyText"
                       Grid.Row="1"
                       Margin="0,14,0,18"
                       Style="{StaticResource DetailTextStyle}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Width="100"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button x:Name="ConfirmButton"
                        Width="100"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Confirm_Click"
                        Content="确定" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

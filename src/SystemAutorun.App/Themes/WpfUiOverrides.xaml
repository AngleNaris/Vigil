<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SystemAccentColor">#6750A4</Color>
    <Color x:Key="SystemAccentColorPrimary">#BFABF1</Color>
    <Color x:Key="SystemAccentColorSecondary">#6750A4</Color>
    <Color x:Key="SystemAccentColorTertiary">#58418F</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush"
                     Color="{StaticResource Primitive.Color.Purple.500}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"
                     Color="{StaticResource Primitive.Color.Purple.300}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Purple.500}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush"
                     Color="{StaticResource Primitive.Color.Purple.600}" />

    <Color x:Key="ApplicationBackgroundColor">#131116</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"
                     Color="{StaticResource Primitive.Color.Background.950}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"
                     Color="{StaticResource Primitive.Color.Text.100}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Text.300}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"
                     Color="{StaticResource Primitive.Color.Text.Disabled}" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"
                     Color="{StaticResource Primitive.Color.Surface.800}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Surface.700}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"
                     Color="{StaticResource Primitive.Color.Surface.850}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush"
                     Color="{StaticResource Primitive.Color.Surface.850}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"
                     Color="{StaticResource Primitive.Color.Border.500}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Border.700}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"
                     Color="{StaticResource Primitive.Color.Surface.800}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Surface.850}" />

    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Surface.700}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"
                     Color="{StaticResource Primitive.Color.Purple.Selection}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"
                     Color="{StaticResource Primitive.Color.Purple.600}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"
                     Color="{StaticResource Primitive.Color.Purple.500}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"
                     Color="{StaticResource Primitive.Color.Purple.Selection}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"
                     Color="{StaticResource Primitive.Color.Border.700}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"
                     Color="{StaticResource Primitive.Color.Primary.Foreground}" />

    <SolidColorBrush x:Key="ControlElevationBorderBrush"
                     Color="{StaticResource Primitive.Color.Border.500}" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush"
                     Color="{StaticResource Primitive.Color.Border.500}" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush"
                     Color="{StaticResource Primitive.Color.Purple.300}" />
</ResourceDictionary>

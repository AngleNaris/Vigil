                                        SnapsToDevicePixels="True">
                                    <ContentPresenter Margin="0,-1,0,1"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Surface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" />
                                    </Trigger>
                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Surface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" /></MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Surface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActive}" />
                                    </Trigger>
                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsHighlighted" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Surface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" /></MultiTrigger>
                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Surface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" /></MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Surface" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.SurfaceInset}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextDisabled}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource Semantic.Brush.FocusAccent}" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="0" />
        <Setter Property="materialDesign:TextFieldAssist.UnderlineCornerRadius" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Semantic.Brush.SurfaceInset}" />
        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Semantic.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
                        <Border x:Name="OuterBorder" services:SurfaceMotion.Fill="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <!-- A template hit surface must not inherit the library's 34-DIP toggle size. -->
                        <ToggleButton x:Name="DropDownToggle" Style="{x:Null}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Selection" Margin="0,-1,0,1" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="PART_EditableTextBox" Margin="8,0,30,0" MinHeight="0" Padding="0" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" /></ControlTemplate></TextBox.Template>
                        </TextBox>
                        <!-- No library shadow chrome, corner radius, presenter gutter or popup offset. -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" VerticalOffset="0"
                               PlacementTarget="{Binding ElementName=ComboRoot}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ComboRoot}" Background="{DynamicResource Semantic.Brush.SurfaceInset}"
                                    BorderBrush="{DynamicResource Semantic.Brush.BorderStrong}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selection" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 4,0 L 8,4" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextDisabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                <Setter Property="services:ColorStateAssist.RestingBorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
            </Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Semantic.Brush.InteractionHover}" /></MultiTrigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="Background" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" /></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsDropDownOpen" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" /></MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionRest}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="services:ColorStateAssist.Role" Value="Foreground" />
        <!-- Preserve the installed Material glyphs and size, not its focus frame/halo. -->
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Width="{Binding Path=(materialDesign:CheckBoxAssist.CheckBoxSize), RelativeSource={RelativeSource TemplatedParent}}"
                         Height="{Binding Path=(materialDesign:CheckBoxAssist.CheckBoxSize), RelativeSource={RelativeSource TemplatedParent}}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" FlowDirection="LeftToRight">
                    <Canvas Width="24" Height="24" Background="Transparent">
                        <Path x:Name="Graphic" Fill="{TemplateBinding Foreground}"
                              Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z" />
                        <Path x:Name="CheckedGlyph" Opacity="0" Fill="{TemplateBinding Foreground}"
                              Data="M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z" />
                        <Path x:Name="IndeterminateGlyph" Opacity="0" Fill="{TemplateBinding Foreground}"
                              Data="M6,13L6,11L18,11L18,13M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z" />
                    </Canvas>
                </Viewbox>
                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" Focusable="False" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasContent" Value="True"><Setter Property="Padding" Value="8,0,0,0" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Graphic" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" />
                    <Setter TargetName="CheckedGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" />
                    <Setter TargetName="IndeterminateGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckedGlyph" Property="services:SurfaceMotion.TargetOpacity" Value="1" />
                    <Setter TargetName="Graphic" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                    <Setter TargetName="CheckedGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                    <Setter TargetName="IndeterminateGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="IndeterminateGlyph" Property="services:SurfaceMotion.TargetOpacity" Value="1" />
                    <Setter TargetName="Graphic" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                    <Setter TargetName="CheckedGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                    <Setter TargetName="IndeterminateGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                    <Setter TargetName="Graphic" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" />
                    <Setter TargetName="CheckedGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" />
                    <Setter TargetName="IndeterminateGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.56" /></Trigger>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter TargetName="Graphic" Property="Fill" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
                    <Setter TargetName="CheckedGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
                    <Setter TargetName="IndeterminateGlyph" Property="Fill" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>


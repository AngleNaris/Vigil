<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.RemoteHostsWindow"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="添加远程服务器"
        Width="560"
        MinWidth="500"
        MaxHeight="640"
        SizeToContent="Height"
        FontSize="13"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
        <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}"
              TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource DialogHeaderBorderStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource DashboardIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="关闭" AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <controls:LineIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:LineIcon x:Name="HeaderIcon" Style="{StaticResource DialogHeaderIconStyle}" Kind="Plus" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="EditorTitle" Style="{StaticResource DialogTitleTextStyle}" Text="添加远程服务器" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource HintTextStyle}" FontSize="{StaticResource Primitive.Font.11}" Text="只读 SSH 概况 · 严格主机指纹校验" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,14,20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="显示名称" />
                            <TextBox x:Name="NameTextBox" AutomationProperties.Name="远程服务器显示名称" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="平台" />
                            <ComboBox x:Name="PlatformComboBox"
                                      AutomationProperties.Name="远程服务器平台"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="主机名 / IP" />
                            <TextBox x:Name="HostTextBox" AutomationProperties.Name="SSH 主机名或 IP" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="SSH 端口" />
                            <TextBox x:Name="PortTextBox" AutomationProperties.Name="SSH 端口" Text="22" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="用户名" />
                            <TextBox x:Name="UserNameTextBox" AutomationProperties.Name="SSH 用户名" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="身份验证" />
                            <ComboBox x:Name="AuthenticationComboBox"
                                      AutomationProperties.Name="SSH 身份验证方式"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="Authentication_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="私钥文件" />
                            <TextBox x:Name="IdentityFileTextBox" AutomationProperties.Name="SSH 私钥文件" />
                        </StackPanel>
                        <Button Grid.Column="4"
                                Margin="0,21,0,0"
                                Style="{StaticResource IconToolbarButtonStyle}"
                                AutomationProperties.Name="选择 SSH 私钥文件"
                                ToolTip="选择 SSH 私钥文件"
                                Click="BrowseIdentity_Click">
                            <controls:LineIcon Width="16" Height="16" Kind="Folder" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="专用 known_hosts 文件" />
                            <TextBox x:Name="KnownHostsFileTextBox" AutomationProperties.Name="SSH known hosts 文件" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Margin="0,21,0,0"
                                Style="{StaticResource IconToolbarButtonStyle}"
                                AutomationProperties.Name="选择 known hosts 文件"
                                ToolTip="选择 known_hosts 文件"
                                Click="BrowseKnownHosts_Click">
                            <controls:LineIcon Width="16" Height="16" Kind="Folder" />
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="代理地址（可选，如 socks5://127.0.0.1:10808）" />
                        <TextBox x:Name="ProxyUriTextBox" AutomationProperties.Name="SSH 代理地址" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="连接超时（秒）" />
                            <TextBox x:Name="ConnectTimeoutTextBox" Text="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="命令超时（秒）" />
                            <TextBox x:Name="CommandTimeoutTextBox" Text="20" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="EnabledCheckBox"
                              Margin="0,12,0,0"
                              Content="启用此服务器"
                              AutomationProperties.Name="启用此服务器" />

                    <Border Margin="0,14,0,0"
                            Padding="10,8"
                            Background="{DynamicResource Semantic.Brush.SurfaceInset}"
                            Style="{StaticResource InteractiveFrameBorderStyle}"
                            BorderThickness="1">
                        <DockPanel>
                            <controls:LineIcon DockPanel.Dock="Left" Width="16"
                                               Height="16"
                                               VerticalAlignment="Top"
                                               Margin="0,1,8,0"
                                               Foreground="{DynamicResource Semantic.Brush.StatusWarning}"
                                               Kind="Lock" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="不保存密码，不自动接受主机指纹；远程探针只读取资源概况。" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource DialogFooterBorderStyle}">
                <UniformGrid Style="{StaticResource DialogActionsStyle}">
                    <Button Margin="4,0"
                            Style="{StaticResource DialogButtonStyle}"
                            IsCancel="True"
                            Content="取消" />
                    <Button x:Name="SaveSettingsButton" Margin="4,0"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            AutomationProperties.Name="添加远程服务器"
                            IsDefault="True"
                            Click="Save_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LineIcon x:Name="SaveIcon" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" Kind="Plus" />
                            <TextBlock x:Name="SaveLabel" Text="添加" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

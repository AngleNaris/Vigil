<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Windows 启动项" Width="680" Height="460" MinWidth="520" MinHeight="360"
        FontSize="13" FontFamily="{StaticResource Semantic.Font.Interface}"
        Foreground="{DynamicResource Semantic.Brush.TextPrimary}" TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}" /></Window.InputBindings>
    <Window.Resources>
        <Style x:Key="StartupMetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartupStatusText" TargetType="TextBlock" BasedOn="{StaticResource StartupMetaText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartupRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="18,9" /><Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.RowRest}" />
            <Setter Property="services:ColorStateAssist.Role" Value="Row" />
            <Setter Property="services:ColorStateAssist.HoverAction" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource Semantic.Brush.BorderSubtle}" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" services:SurfaceMotion.Fill="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionHover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActive}" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Row" Property="services:SurfaceMotion.Fill" Value="{DynamicResource Semantic.Brush.InteractionActiveHover}" /></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
    <Border Background="{DynamicResource Semantic.Brush.WindowBackground}" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="38" /><ColumnDefinition Width="38" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Windows 启动项" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource Semantic.Font.Monospace}"
                                   Foreground="{DynamicResource Semantic.Brush.TextHint}" Text="{Binding CountMessage}" ToolTip="匹配显示数 / 当前已读数" />
                    </StackPanel>
                    <Border x:Name="SearchSurface" Grid.Column="2" Height="30" Margin="0,0,6,0" services:FrameHoverAssist.Track="True" BorderBrush="{Binding BorderBrush, ElementName=SearchBox}" BorderThickness="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:LineIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" MinHeight="0" Height="28" Padding="2,0,8,0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" services:ColorStateAssist.RestingBorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" services:ColorStateAssist.FrameHovered="{Binding Path=(services:FrameHoverAssist.IsInside), ElementName=SearchSurface}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索启动项" ToolTip="搜索启动项 (Ctrl+F)" />
                        </Grid>
                    </Border>
                    <Button x:Name="FilterButton" Grid.Column="3" Style="{StaticResource DashboardIconButton}" Width="38" Height="36" Click="Filter_Click" ToolTip="{Binding SelectedFilter.Label, StringFormat=筛选：{0}}" AutomationProperties.Name="筛选启动项" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <controls:LineIcon Kind="Filter" Width="16" Height="16" />
                        <Button.ContextMenu><ContextMenu Placement="Bottom">
                            <MenuItem Header="全部" Tag="" IsCheckable="True" Click="FilterOption_Click" />
                            <MenuItem Header="已登记" Tag="active" IsCheckable="True" Click="FilterOption_Click" />
                            <MenuItem Header="已禁用" Tag="disabled" IsCheckable="True" Click="FilterOption_Click" />
                            <MenuItem Header="本配置纳管" Tag="managed" IsCheckable="True" Click="FilterOption_Click" />
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource DashboardIconButton}" Width="38" Height="36" Command="{Binding RefreshCommand}" ToolTip="刷新 (F5)" AutomationProperties.Name="刷新启动项" shell:WindowChrome.IsHitTestVisibleInChrome="True"><controls:LineIcon Kind="Refresh" Width="16" Height="16" /></Button>
                    <Button Grid.Column="5" Style="{StaticResource DashboardIconButton}" Width="38" Height="36" Click="Close_Click" ToolTip="关闭 (Esc)" AutomationProperties.Name="关闭启动项管理器" shell:WindowChrome.IsHitTestVisibleInChrome="True"><controls:LineIcon Kind="Close" Width="14" Height="14" /></Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="StartupList" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Windows 启动项列表"
                         ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" ItemContainerStyle="{StaticResource StartupRow}"
                         MouseDoubleClick="StartupList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" KeyboardNavigation.TabNavigation="Once">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid ToolTip="{Binding Entry.RawCommand}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <controls:LineIcon Kind="{Binding Icon}" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Grid.Column="2" Margin="12,0" Text="{Binding Target}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="12" Style="{StaticResource StartupMetaText}" />
                            <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="{Binding Source}" FontFamily="{StaticResource Semantic.Font.Monospace}" FontSize="11" Style="{StaticResource StartupMetaText}" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusDescription}" FontSize="12" Style="{StaticResource StartupStatusText}" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="20,30" Text="{Binding EmptyStateTitle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextSecondary}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False" />
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" Foreground="{DynamicResource Semantic.Brush.TextSecondary}"
                               Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0" Click="Close_Click" Content="关闭" AutomationProperties.Name="关闭启动项管理器" />
                        <Button x:Name="AdoptButton" Style="{StaticResource DialogPrimaryButtonStyle}" MinWidth="136" Command="{Binding AddToTasksCommand}"
                                Content="添加到监控列表" ToolTip="将选中的启动项添加到监控列表" AutomationProperties.Name="添加到监控列表" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </controls:PresencePanel>
</services:ToolWindow>

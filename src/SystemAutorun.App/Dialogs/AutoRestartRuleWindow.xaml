<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.AutoRestartRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="自动化规则设置"
        Width="560"
        MinWidth="500"
        MaxHeight="660"
        SizeToContent="Height"
        FontSize="13"
        FontFamily="{StaticResource Semantic.Font.Interface}"
        Foreground="{DynamicResource Semantic.Brush.TextPrimary}"
        TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
        <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Style="{StaticResource DialogHeaderBorderStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DashboardIconButton}"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <controls:LineIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:LineIcon x:Name="HeaderIcon" Style="{StaticResource DialogHeaderIconStyle}" Kind="Restart" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Grid.Column="1"
                                   Style="{StaticResource DialogTitleTextStyle}"
                                   Text="自动化规则设置"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,14,20,18">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8" Text="目标与执行方式" />

                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="规则名称" />
                        <TextBox x:Name="RuleNameTextBox" AutomationProperties.Name="规则名称" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="目标类型" />
                            <ComboBox x:Name="TargetKindComboBox" SelectionChanged="TargetOrAction_Changed" AutomationProperties.Name="目标类型">
                                <ComboBoxItem Tag="process" Content="自定义进程" />
                                <ComboBoxItem Tag="managed_task" Content="已纳管服务" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="执行方式" />
                            <ComboBox x:Name="ActionModeComboBox" SelectionChanged="TargetOrAction_Changed" AutomationProperties.Name="执行方式">
                                <ComboBoxItem Tag="terminate_only" Content="仅结束（系统自拉起/清理）" />
                                <ComboBoxItem Tag="terminate_and_relaunch" Content="结束并重新启动" />
                                <ComboBoxItem Tag="restart_task" Content="重启已纳管服务" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ManagedTaskPanel" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="目标服务" />
                        <ComboBox x:Name="TaskNameComboBox" AutomationProperties.Name="目标服务" />
                    </StackPanel>

                    <StackPanel x:Name="ProcessTargetPanel" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="进程名（任意进程，如 dwm、dopus）" />
                                <TextBox x:Name="ProcessNameTextBox" AutomationProperties.Name="进程名" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="命令行包含（可选，如 /factory）" />
                                <TextBox x:Name="CommandLineFilterTextBox" AutomationProperties.Name="命令行包含" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="RequireElevationCheckBox"
                                  Margin="0,10,0,0"
                                  Content="权限不足时经系统提权维护通道结束进程（不受进程白名单限制）"
                                  AutomationProperties.Name="使用系统提权维护通道" />

                        <Expander x:Name="RelaunchFieldsPanel"
                                  Style="{StaticResource CompactDisclosure}"
                                  Header="自定义重启路径与参数（留空则沿用原进程路径）"
                                  Background="Transparent"
                                  Margin="0,10,0,0"
                                  Visibility="Collapsed">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="重启程序路径（可选）" />
                                <TextBox x:Name="ExecutablePathTextBox" AutomationProperties.Name="重启程序路径" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="启动参数（可选）" />
                                        <TextBox x:Name="ArgumentsTextBox" AutomationProperties.Name="启动参数" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="工作目录（可选）" />
                                        <TextBox x:Name="WorkingDirTextBox" AutomationProperties.Name="工作目录" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Border Margin="0,14,0,12" Height="1" Background="{DynamicResource Semantic.Brush.BorderSubtle}" />
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8" Text="自动触发条件" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="定时方式" />
                            <ComboBox x:Name="ScheduleKindComboBox" SelectionChanged="ScheduleKind_Changed" AutomationProperties.Name="定时方式">
                                <ComboBoxItem Tag="none" Content="不按定时触发" />
                                <ComboBoxItem Tag="interval" Content="按固定间隔（分钟）" />
                                <ComboBoxItem Tag="daily" Content="每日定点（HH:mm）" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="IntervalPanel" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="间隔分钟数 (5 ~ 43200)" />
                            <TextBox x:Name="IntervalMinutesTextBox" AutomationProperties.Name="间隔分钟数" />
                        </StackPanel>
                        <StackPanel x:Name="DailyTimePanel" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="每日本地时间 (HH:mm)" />
                            <TextBox x:Name="DailyTimeTextBox" AutomationProperties.Name="每日触发时间" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="总 CPU (%)" />
                            <TextBox x:Name="CpuThresholdTextBox" AutomationProperties.Name="CPU 触发阈值" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="内存 (MB)" />
                            <TextBox x:Name="MemoryMbThresholdTextBox" AutomationProperties.Name="内存触发阈值 MB" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="总句柄数" />
                            <TextBox x:Name="HandleThresholdTextBox" AutomationProperties.Name="总句柄阈值" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="不活跃句柄" />
                            <TextBox x:Name="InactiveHandleThresholdTextBox" AutomationProperties.Name="不活跃句柄阈值" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="持续超标秒数 (0 ~ 3600)" />
                            <TextBox x:Name="SustainSecondsTextBox" AutomationProperties.Name="持续超标秒数" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="冷却间隔分钟 (1 ~ 10080)" />
                            <TextBox x:Name="CooldownMinutesTextBox" AutomationProperties.Name="冷却间隔分钟" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="RuleEnabledCheckBox"
                              Margin="0,14,0,0"
                              Content="保存后启用自动触发（后台持续巡检；不勾选则仅保留为手动规则，随时可点「立即执行一次」）"
                              AutomationProperties.Name="启用自动触发" />

                    <TextBlock x:Name="ValidationText"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource Semantic.Brush.StatusFailed}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource DialogFooterBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Semantic.Brush.TextHint}"
                               FontSize="{StaticResource Primitive.Font.11}"
                               Text="阈值留空或填 0 表示不启用该项条件" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource DialogButtonStyle}"
                                Margin="0,0,8,0"
                                Content="取消"
                                Click="Cancel_Click"
                                AutomationProperties.Name="取消" />
                        <Button x:Name="SaveButton"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Content="保存规则"
                                Click="Save_Click"
                                AutomationProperties.Name="保存规则" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

<UserControl x:Class="SystemAutorun.App.Controls.HostResourceCharts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SystemAutorun.App.Controls" xmlns:services="clr-namespace:SystemAutorun.App.Services">
  <Grid services:DataChangePulse.Context="{Binding DashboardDataPulseContext}">
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="20,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding DashboardResourceCaption}" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" FontSize="12" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Height="32" Style="{StaticResource InteractiveFrameBorderStyle}" BorderThickness="1">
          <Button x:Name="HostWindowButton" Style="{StaticResource DashboardHeaderChoice}" Click="ResourceMenu_Click" AutomationProperties.Name="主机资源时间段" ToolTip="切换实时（最近5分钟）或最近1天、1周、1月历史">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DashboardHealthWindowLabel}" VerticalAlignment="Center" Margin="0,-1,0,1" /><controls:LineIcon Kind="Down" Width="11" Height="11" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
            <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="实时" IsCheckable="True" IsChecked="{Binding IsRealtimeWindow, Mode=OneWay}" Command="{Binding SelectDashboardWindowCommand}" CommandParameter="0" />
              <MenuItem Header="最近1天" IsCheckable="True" IsChecked="{Binding IsOneDayWindow, Mode=OneWay}" Command="{Binding SelectDashboardWindowCommand}" CommandParameter="24" />
              <MenuItem Header="最近1周" IsCheckable="True" IsChecked="{Binding IsOneWeekWindow, Mode=OneWay}" Command="{Binding SelectDashboardWindowCommand}" CommandParameter="168" />
              <MenuItem Header="最近1月" IsCheckable="True" IsChecked="{Binding IsOneMonthWindow, Mode=OneWay}" Command="{Binding SelectDashboardWindowCommand}" CommandParameter="720" />
            </ContextMenu></Button.ContextMenu>
          </Button>
        </Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Style="{StaticResource DashboardMetricCell}" Padding="20,16" services:LineMotion.Region="1" AutomationProperties.Name="主机CPU">
        <StackPanel>
          <controls:MetricHeadingPanel MinHeight="34">
            <StackPanel Orientation="Horizontal"><controls:LineIcon x:Name="HostCpuIcon" Kind="Cpu" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" /><TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="CPU" /></StackPanel>
            <TextBlock x:Name="HostCpuReadout" Style="{StaticResource DashboardReadout}" FontSize="24" services:SurfaceMotion.RollingText="{Binding HostResourceCpuText}" services:DataChangePulse.Value="{Binding HostResourceCpuText}" />
          </controls:MetricHeadingPanel>
          <controls:DashboardPlot x:Name="HostCpuPlot" Height="118" PlotLeftInset="0.5" PlotRightInset="0.5" Points="{Binding HostResourceCpu}" WindowDuration="{Binding DashboardResourceDuration}" EndAt="{Binding DashboardResourceEnd}" ScaleKey="{Binding DashboardResourceScaleKey}" DataAt="{Binding DashboardResourceDataAt}" IsLoading="{Binding IsResourceLoading}" EmptyText="{Binding DashboardResourceEmptyText}" AutomationProperties.Name="主机CPU轨迹" AutomationProperties.HelpText="{Binding HostResourceHelp}" />
          <TextBlock Style="{StaticResource MetricDetailStyle}" Text="{Binding HostLogicalProcessorsText}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource DashboardMetricCell}" Padding="20,16" BorderThickness="0,0,0,1" services:LineMotion.Region="2" AutomationProperties.Name="主机内存用量">
        <StackPanel>
          <controls:MetricHeadingPanel MinHeight="34">
            <StackPanel Orientation="Horizontal"><controls:LineIcon x:Name="HostMemoryIcon" Kind="Memory" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" /><TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="内存" /></StackPanel>
            <TextBlock x:Name="HostMemoryReadout" Style="{StaticResource DashboardReadout}" FontSize="24" services:SurfaceMotion.RollingText="{Binding HostMemoryPercentText}" services:DataChangePulse.Value="{Binding HostMemoryPercentText}" />
          </controls:MetricHeadingPanel>
          <controls:DashboardPlot x:Name="HostMemoryPlot" Height="118" PlotLeftInset="0.5" PlotRightInset="0.5" Points="{Binding HostResourceMemory}" Bytes="True" WindowDuration="{Binding DashboardResourceDuration}" EndAt="{Binding DashboardResourceEnd}" ScaleKey="{Binding DashboardResourceScaleKey}" DataAt="{Binding DashboardResourceDataAt}" IsLoading="{Binding IsResourceLoading}" EmptyText="{Binding DashboardResourceEmptyText}" AutomationProperties.Name="主机内存字节轨迹" AutomationProperties.HelpText="{Binding HostResourceHelp}" />
          <TextBlock Style="{StaticResource MetricDetailStyle}" Text="{Binding MemoryUsageText}" services:DataChangePulse.Value="{Binding MemoryUsageText}" />
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource DashboardMetricCell}" Padding="20,16" services:LineMotion.Region="3" AutomationProperties.Name="整机磁盘IO">
        <StackPanel>
          <controls:MetricHeadingPanel MinHeight="34">
            <StackPanel Orientation="Horizontal"><controls:LineIcon x:Name="HostDiskIcon" Kind="Disk" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" /><TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="磁盘IO" /><controls:PlotLegendHelp Margin="5,0,0,0" VerticalAlignment="Center" Legend="Disk" AccessibleName="磁盘读写图例" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="磁盘读取" AutomationProperties.Name="磁盘读取速率"><controls:LineIcon Kind="Inbound" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.Accent}" /><TextBlock x:Name="HostDiskReadout" Style="{StaticResource DashboardReadout}" FontSize="16" services:SurfaceMotion.RollingText="{Binding HostDiskReadText}" services:DataChangePulse.Value="{Binding HostDiskReadText}" /></StackPanel>
          </controls:MetricHeadingPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="磁盘写入" AutomationProperties.Name="磁盘写入速率"><controls:LineIcon Kind="Outbound" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.ChartSecondary}" /><TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Semantic.Font.Monospace}" Foreground="{DynamicResource Semantic.Brush.TextHint}" services:SurfaceMotion.RollingText="{Binding HostDiskWriteText}" services:DataChangePulse.Value="{Binding HostDiskWriteText}" /></StackPanel>
          <controls:DashboardPlot x:Name="HostDiskPlot" Height="118" PlotLeftInset="0.5" PlotRightInset="0.5" Points="{Binding HostResourceDiskRead}" SecondaryPoints="{Binding HostResourceDiskWrite}" Rate="True" PrimaryLabel="读" SecondaryLabel="写" WindowDuration="{Binding DashboardResourceDuration}" EndAt="{Binding DashboardResourceEnd}" ScaleKey="{Binding DashboardResourceScaleKey}" DataAt="{Binding DashboardResourceDataAt}" IsLoading="{Binding IsResourceLoading}" EmptyText="{Binding DashboardResourceEmptyText}" AutomationProperties.Name="整机磁盘读写速率轨迹" AutomationProperties.HelpText="{Binding HostResourceHelp}" />
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardMetricCell}" Padding="20,16" BorderThickness="0,0,0,1" services:LineMotion.Region="4" AutomationProperties.Name="网络收发速率">
        <StackPanel>
          <controls:MetricHeadingPanel MinHeight="34">
            <StackPanel Orientation="Horizontal"><controls:LineIcon x:Name="HostNetworkIcon" Kind="Network" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.TextHint}" /><TextBlock Margin="10,0,0,0" Style="{StaticResource MetricCaptionStyle}" Text="网络" /><controls:PlotLegendHelp Margin="5,0,0,0" VerticalAlignment="Center" Legend="Network" AccessibleName="网络收发图例" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="网络接收" AutomationProperties.Name="网络接收速率"><controls:LineIcon Kind="Inbound" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.Accent}" /><TextBlock x:Name="HostNetworkReadout" Style="{StaticResource DashboardReadout}" FontSize="16" services:SurfaceMotion.RollingText="{Binding HostReceiveText}" services:DataChangePulse.Value="{Binding HostReceiveText}" /></StackPanel>
          </controls:MetricHeadingPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="网络发送" AutomationProperties.Name="网络发送速率"><controls:LineIcon Kind="Outbound" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Semantic.Brush.ChartSecondary}" /><TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Semantic.Font.Monospace}" Foreground="{DynamicResource Semantic.Brush.TextHint}" services:SurfaceMotion.RollingText="{Binding HostSendText}" services:DataChangePulse.Value="{Binding HostSendText}" /></StackPanel>
          <controls:DashboardPlot x:Name="HostNetworkPlot" Height="118" PlotLeftInset="0.5" PlotRightInset="0.5" Points="{Binding HostResourceReceive}" SecondaryPoints="{Binding HostResourceSend}" Rate="True" PrimaryLabel="收" SecondaryLabel="发" WindowDuration="{Binding DashboardResourceDuration}" EndAt="{Binding DashboardResourceEnd}" ScaleKey="{Binding DashboardResourceScaleKey}" DataAt="{Binding DashboardResourceDataAt}" IsLoading="{Binding IsResourceLoading}" EmptyText="{Binding DashboardResourceEmptyText}" AutomationProperties.Name="网络收发速率轨迹" AutomationProperties.HelpText="{Binding HostResourceHelp}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

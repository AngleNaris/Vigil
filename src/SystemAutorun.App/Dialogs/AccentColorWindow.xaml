<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.AccentColorWindow"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="自定义强调色"
        Width="480"
        MinWidth="440"
        SizeToContent="Height"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
        <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}"
              TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource DialogHeaderBorderStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource DashboardIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="关闭" AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <controls:LineIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:LineIcon Style="{StaticResource DialogHeaderIconStyle}"
                                           Foreground="{DynamicResource Semantic.Brush.Accent}"
                                           Kind="Settings" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DialogTitleTextStyle}" Text="自定义强调色" />
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,14,20,18">
                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="主题预设" />
                <UniformGrid x:Name="PresetGrid" Columns="3" Margin="-3,0">
                    <!-- Populated in code-behind from ThemeService.AccentPresets -->
                </UniformGrid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="十六进制色值（#RRGGBB）" />
                        <TextBox x:Name="HexTextBox"
                                 AutomationProperties.Name="强调色十六进制色值"
                                 FontFamily="{StaticResource Semantic.Font.Monospace}"
                                 TextChanged="HexTextBox_TextChanged" />
                    </StackPanel>
                    <Button x:Name="ResetButton"
                            Grid.Column="2"
                            Margin="0,20,0,0"
                            Style="{StaticResource DialogButtonStyle}"
                            AutomationProperties.Name="恢复默认强调色"
                            Click="Reset_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Kind="Restart" />
                            <TextBlock Text="恢复默认" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Margin="0,14,0,0"
                        Padding="12,10"
                        Background="{DynamicResource Semantic.Brush.SurfacePrimary}"
                        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PreviewSwatch"
                                Width="32"
                                Height="32"
                                BorderBrush="{DynamicResource Semantic.Brush.BorderStrong}"
                                BorderThickness="1" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTitleText" Text="预览效果" />
                            <TextBlock x:Name="PreviewHintText"
                                       Margin="0,2,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       FontSize="{StaticResource Primitive.Font.11}"
                                       Text="作用于悬停、激活、趋势曲线、加载动画与品牌图标；故障块与异常告警保持警示红。" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource DialogFooterBorderStyle}">
                <UniformGrid Style="{StaticResource DialogActionsStyle}">
                    <Button Margin="4,0"
                            Style="{StaticResource DialogButtonStyle}"
                            IsCancel="True"
                            Content="取消" />
                    <Button x:Name="ApplyButton"
                            Margin="4,0"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            AutomationProperties.Name="应用强调色"
                            IsDefault="True"
                            Click="Apply_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LineIcon Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Kind="Check" />
                            <TextBlock Text="应用" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

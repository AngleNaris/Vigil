<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.MessageDialog"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vigil"
        Width="480"
        MinWidth="400"
        SizeToContent="Height"
        MaxHeight="480"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
    <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}"
          TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DialogHeaderBorderStyle}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DashboardIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                        ToolTip="关闭" AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:LineIcon Kind="Close" Width="15" Height="15" />
                </Button>                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:LineIcon x:Name="DialogIcon"
                                             Style="{StaticResource DialogHeaderIconStyle}"
                                             Kind="Info" />
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Style="{StaticResource DialogTitleTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" MaxHeight="390" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyText"
                       Margin="20,16,20,18"
                       AutomationProperties.Name="消息内容"
                       Style="{StaticResource DetailTextStyle}"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorderStyle}">
            <UniformGrid Style="{StaticResource DialogActionsStyle}">
                <Button x:Name="CancelButton"
                        Margin="4,0"
                        AutomationProperties.Name="取消"
                        Style="{StaticResource DialogButtonStyle}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button x:Name="ConfirmButton" Margin="4,0"
                        AutomationProperties.Name="确定"
                        IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Click="Confirm_Click"
                        Content="确定" />
            </UniformGrid>
        </Border>
    </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

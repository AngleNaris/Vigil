<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Semantic.Brush.WindowBackground"
                     Color="{StaticResource Primitive.Color.Background.950}" />
    <SolidColorBrush x:Key="Semantic.Brush.SurfacePrimary"
                     Color="{StaticResource Primitive.Color.Surface.800}" />
    <SolidColorBrush x:Key="Semantic.Brush.SurfaceInset"
                     Color="{StaticResource Primitive.Color.Surface.850}" />
    <SolidColorBrush x:Key="Semantic.Brush.SurfaceHover"
                     Color="{StaticResource Primitive.Color.Surface.700}" />
    <SolidColorBrush x:Key="Semantic.Brush.BorderStrong"
                     Color="{StaticResource Primitive.Color.Border.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.BorderSubtle"
                     Color="{StaticResource Primitive.Color.Border.700}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextPrimary"
                     Color="{StaticResource Primitive.Color.Text.100}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextSecondary"
                     Color="{StaticResource Primitive.Color.Text.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextHint"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.TextDisabled"
                     Color="{StaticResource Primitive.Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Semantic.Brush.ActionPrimary"
                     Color="{StaticResource Primitive.Color.Purple.600}" />
    <SolidColorBrush x:Key="Semantic.Brush.ActionPrimaryHover"
                     Color="{StaticResource Primitive.Color.Purple.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.FocusAccent"
                     Color="{StaticResource Primitive.Color.Purple.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.Selection"
                     Color="{StaticResource Primitive.Color.Purple.Selection}" />
    <SolidColorBrush x:Key="Semantic.Brush.PrimaryForeground"
                     Color="{StaticResource Primitive.Color.Primary.Foreground}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusHealthy"
                     Color="{StaticResource Primitive.Color.Success.400}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusFailed"
                     Color="{StaticResource Primitive.Color.Error.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusDisabled"
                     Color="{StaticResource Primitive.Color.Text.500}" />
    <SolidColorBrush x:Key="Semantic.Brush.StatusWarning"
                     Color="{StaticResource Primitive.Color.Warning.300}" />
    <SolidColorBrush x:Key="Semantic.Brush.DangerHover"
                     Color="{StaticResource Primitive.Color.Error.Surface}" />
</ResourceDictionary>

<Window x:Class="SystemAutorun.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="系统自启动管理器"
        Width="1360"
        Height="880"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusDisabled}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusHealthy}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                    <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusFailed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusDisabled}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusHealthy}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusFailed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="编辑配置 (autorun.yaml)" Command="{Binding EditConfigCommand}" />
                <MenuItem Header="打开日志目录" Command="{Binding OpenLogsCommand}" />
                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="系统诊断 (Doctor)" Command="{Binding DoctorCommand}" />
                <MenuItem Header="管理自动启动项" Command="{Binding OpenStartupManagerCommand}" />
                <MenuItem Header="添加程序任务" Command="{Binding AddProgramCommand}" />
                <Separator />
                <MenuItem Header="安装系统启动执行器" Click="InstallBoot_Click" />
                <MenuItem Header="卸载系统启动执行器" Click="UninstallBoot_Click" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" MinHeight="28">
            <TextBlock Text="{Binding StatusMessage}" />
            <Separator />
            <ProgressBar Width="64"
                         IsIndeterminate="True"
                         Style="{StaticResource BusyProgressStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Separator />
            <TextBlock Text="{Binding CountMessage}" />
        </StatusBar>

        <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="660" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="420" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Text="任务列表" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="{Binding CountMessage}" />
                        <TextBox Grid.Column="3"
                                 Margin="0,0,8,0"
                                 AutomationProperties.Name="搜索任务"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索名称、类型、原因或详情" />
                        <ComboBox Grid.Column="4"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding StatusFilters}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedStatusFilter}" />
                        <ComboBox Grid.Column="5"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding TypeFilters}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedTypeFilter}" />
                        <CheckBox Grid.Column="6"
                                  VerticalAlignment="Center"
                                  Content="自动刷新"
                                  IsChecked="{Binding AutoRefresh}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="TaskGrid"
                                  ItemsSource="{Binding TasksView}"
                                  SelectedItem="{Binding SelectedTask}"
                                  MouseDoubleClick="TaskGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="状态" Width="80" CanUserSort="True" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{Binding Status}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="110" />
                                <DataGridTextColumn Header="Distro" Binding="{Binding Distro}" Width="100" />
                                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="200" />
                                <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="200" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="30"
                                       Foreground="{StaticResource Semantic.Brush.TextHint}"
                                       Text="&#xE71C;" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="没有符合当前筛选条件的任务" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Semantic.Brush.WindowBackground}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource PanelPrimaryButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource PanelActionButtonStyle}"
                            Command="{Binding AddProgramCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE710;" />
                            <TextBlock Text="添加程序" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="任务详情" />

                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                DataContext="{Binding SelectedTask}"
                                Style="{StaticResource StatusBadgeBorderStyle}">
                            <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{Binding Status, FallbackValue=OFF}" />
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="{Binding SelectedTask.Name, TargetNullValue=选择左侧任务查看状态与操作。}" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,6,0,0"
                                   MaxHeight="72"
                                   Style="{StaticResource DetailTextStyle}"
                                   Text="{Binding SelectedTask.Description}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="{Binding SelectedTask.LaunchSummary}" />

                        <StackPanel Grid.Row="5" Margin="0,14,0,0">
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitleTextStyle}" Text="操作" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelPrimaryButtonStyle}" Command="{Binding StartCommand}" Content="启动" />
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelDangerButtonStyle}" Command="{Binding StopCommand}" Content="停止" />
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelActionButtonStyle}" Command="{Binding RestartCommand}" Content="重启" />
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelActionButtonStyle}" Command="{Binding EnableCommand}" Content="启用" />
                                <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource PanelDangerButtonStyle}" Command="{Binding DisableCommand}" Content="禁用" />
                                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource PanelDangerButtonStyle}" Command="{Binding RemoveTaskCommand}" Content="移出列表" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Margin="0,14,0,0">
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitleTextStyle}" Text="辅助" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PanelActionButtonStyle}" Command="{Binding ShowDetailCommand}" Content="查看日志" />
                                <Button Grid.Column="2" Style="{StaticResource PanelActionButtonStyle}" Command="{Binding ShowDetailCommand}" Content="详细信息" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Margin="0,14,0,0">
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitleTextStyle}" Text="全局选项" />
                            <CheckBox Margin="0,0,0,10"
                                      Content="本工具随用户登录后台启动"
                                      IsChecked="{Binding IsSelfStartupEnabled}"
                                      Click="SelfStartup_Click" />
                            <CheckBox Margin="0,0,0,10"
                                      Content="启动后自动补启动未运行任务"
                                      IsChecked="{Binding StartMissingOnLaunch}" />
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Command="{Binding StartMissingCommand}"
                                    Content="立即补启动未运行任务" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

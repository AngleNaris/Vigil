<ui:FluentWindow x:Class="SystemAutorun.App.Dialogs.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="系统诊断"
        Width="900"
        Height="540"
        MinWidth="760"
        MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" Style="{StaticResource PanelTitleTextStyle}" />
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <DataGrid ItemsSource="{Binding}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="检查项" Binding="{Binding Check}" Width="320" />
                    <DataGridTextColumn Header="结果" Binding="{Binding Ok}" Width="80" />
                    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button Grid.Row="4"
                Width="100"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="Close_Click"
                Content="关闭" />
    </Grid>
</ui:FluentWindow>

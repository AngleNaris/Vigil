<Window x:Class="SystemAutorun.App.Dialogs.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务详细信息"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding Task.Name}" />
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HintTextStyle}" Text="健康状态" />
                <TextBlock Grid.Column="1" Text="{Binding Health.Reason}" />
                <TextBlock Grid.Row="1" Style="{StaticResource HintTextStyle}" Text="详情" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Health.Detail}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Style="{StaticResource HintTextStyle}" Text="启动模式" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Task.Launch}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Style="{StaticResource HintTextStyle}" Text="进程 PID" />
                <TextBlock x:Name="ProcessText" Grid.Row="3" Grid.Column="1" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Style="{StaticResource SectionTitleTextStyle}" Text="最近日志" />
        <TextBox x:Name="LogsText"
                 Grid.Row="6"
                 AcceptsReturn="True"
                 FontFamily="{StaticResource Semantic.Font.Monospace}"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
        <Button Grid.Row="8"
                Width="100"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="Close_Click"
                Content="关闭" />
    </Grid>
</Window>

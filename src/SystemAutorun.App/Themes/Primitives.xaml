<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Approved dashboard r4 (R127 lifted dark surfaces & soft gray-white inks); shared by the dashboard and existing dialogs. -->
    <Color x:Key="Primitive.Color.Background.950">#141417</Color>
    <Color x:Key="Primitive.Color.Surface.800">#18181C</Color>
    <Color x:Key="Primitive.Color.Surface.850">#1C1C21</Color>
    <Color x:Key="Primitive.Color.Surface.700">#26262D</Color>
    <Color x:Key="Primitive.Color.Border.500">#3B3B45</Color>
    <Color x:Key="Primitive.Color.Border.700">#2B2B33</Color>
    <Color x:Key="Primitive.Color.Text.100">#D4D4DC</Color>
    <Color x:Key="Primitive.Color.Text.300">#A1A1AA</Color>
    <Color x:Key="Primitive.Color.Text.500">#8B8B95</Color>
    <Color x:Key="Primitive.Color.Text.Disabled">#5C5C66</Color>
    <Color x:Key="Primitive.Color.Text.Bright">#E0E0E6</Color>
    <Color x:Key="Primitive.Color.Action.Default">#D4D4DC</Color>
    <Color x:Key="Primitive.Color.Action.Hover">#E0E0E6</Color>
    <Color x:Key="Primitive.Color.Action.Focus">#DCDCE2</Color>
    <Color x:Key="Primitive.Color.Focus.OnLight">#6B6B75</Color>
    <Color x:Key="Primitive.Color.Selection">#202026</Color>
    <Color x:Key="Primitive.Color.Action.Pressed">#A1A1AA</Color>
    <Color x:Key="Primitive.Color.Primary.Foreground">#141417</Color>
    <Color x:Key="Primitive.Color.Success.400">#A1A1AA</Color>
    <Color x:Key="Primitive.Color.Error.300">#E11D48</Color>
    <Color x:Key="Primitive.Color.Error.400">#BE123C</Color>
    <Color x:Key="Primitive.Color.Interaction.DarkHover">#C41740</Color>
    <Color x:Key="Primitive.Color.Interaction.DarkActiveHover">#A61338</Color>
    <!-- R128: neutral grey active surface + red ink (4.56:1), keeping filled red exclusive to hover/pressed. -->
    <Color x:Key="Primitive.Color.Interaction.DarkActiveSurface">#24242B</Color>
    <Color x:Key="Primitive.Color.Interaction.DarkOnActive">#F84B68</Color>
    <Color x:Key="Primitive.Color.Chart.SecondaryDark">#9E334D</Color>
    <Color x:Key="Primitive.Color.Error.Surface">#2A0A13</Color>
    <Color x:Key="Primitive.Color.Warning.300">#D4A95A</Color>
    <Color x:Key="Primitive.Color.Critical.300">#F43F5E</Color>
    <!-- R127: soft gray-white ink on filled red controls (4.79:1 on DarkHover #C41740, 6.08:1 on DarkActiveHover #A61338). -->
    <Color x:Key="Primitive.Color.OnStatus">#E6E6EC</Color>
    <Color x:Key="Primitive.Color.Info.300">#A1A1AA</Color>
    <Color x:Key="Primitive.Color.Terminal.950">#111114</Color>
    <Color x:Key="Primitive.Color.History.Healthy">#43434E</Color>

    <sys:Double x:Key="Primitive.Space.1">4</sys:Double>
    <sys:Double x:Key="Primitive.Space.2">8</sys:Double>
    <sys:Double x:Key="Primitive.Space.3">12</sys:Double>
    <sys:Double x:Key="Primitive.Space.4">16</sys:Double>
    <sys:Double x:Key="Primitive.Space.PageX">18</sys:Double>
    <sys:Double x:Key="Primitive.Space.6">24</sys:Double>

    <sys:Double x:Key="Primitive.Font.11">11</sys:Double>
    <sys:Double x:Key="Primitive.Font.12">12</sys:Double>
    <sys:Double x:Key="Primitive.Font.13">13</sys:Double>
    <sys:Double x:Key="Primitive.Font.14">14</sys:Double>
    <sys:Double x:Key="Primitive.Font.16">16</sys:Double>
    <sys:Double x:Key="Primitive.Font.20">20</sys:Double>
    <sys:Double x:Key="Primitive.Font.24">24</sys:Double>
</ResourceDictionary>

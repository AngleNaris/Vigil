<services:ToolWindow x:Class="SystemAutorun.App.Dialogs.DoctorWindow"
        xmlns:services="clr-namespace:SystemAutorun.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:SystemAutorun.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vigil"
        Width="800"
        Height="480"
        MinWidth="680"
        MinHeight="400"
        WindowStyle="None"
        BorderBrush="{DynamicResource Semantic.Brush.BorderSubtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DoctorResultBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="DoctorResultTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatusBadgeTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusFailed}" />
            <Setter Property="Text" Value="FAIL" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.StatusHealthy}" />
                    <Setter Property="Text" Value="OK" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnActive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Semantic.Brush.InteractionOnHover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <controls:PresencePanel MotionKind="Tool" IsPresented="True">
    <Grid Background="{DynamicResource Semantic.Brush.WindowBackground}"
          TextElement.Foreground="{DynamicResource Semantic.Brush.TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DialogHeaderBorderStyle}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DashboardIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                        ToolTip="关闭" AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:LineIcon Kind="Close" Width="15" Height="15" />
                </Button>                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:LineIcon Style="{StaticResource DialogHeaderIconStyle}"
                                             Kind="Shield" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource DialogTitleTextStyle}"
                               Text="系统诊断" />
                    <TextBlock x:Name="SummaryText"
                               Grid.Column="2"
                               AutomationProperties.LiveSetting="Polite"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontFamily="{StaticResource Semantic.Font.Monospace}" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1">
            <Grid>
                <DataGrid x:Name="DoctorGrid"
                          AutomationProperties.Name="诊断检查结果"
                          ItemsSource="{Binding}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="检查项" Binding="{Binding Check}" Width="2*" MinWidth="180" />
                        <DataGridTemplateColumn Header="结果"
                                                Width="82"
                                                HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DoctorResultBorderStyle}">
                                        <TextBlock Style="{StaticResource DoctorResultTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="详情" Width="3*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detail}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Detail}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource Semantic.Brush.WindowBackground}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=DoctorGrid, Path=Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:LineIcon Width="24"
                                                 Height="24"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Semantic.Brush.TextHint}"
                                                 Kind="Info" />
                        <TextBlock Margin="0,9,0,0"
                                   Style="{StaticResource PanelTitleTextStyle}"
                                   Text="没有诊断结果" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorderStyle}">
            <UniformGrid Style="{StaticResource DialogActionsStyle}">
                <Button Margin="4,0" AutomationProperties.Name="关闭系统诊断"
                        Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="Close_Click" Content="关闭" />
            </UniformGrid>
        </Border>
    </Grid>
    </controls:PresencePanel>
</services:ToolWindow>

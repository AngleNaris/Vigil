<Window x:Class="SystemAutorun.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="系统自启动管理器"
        Width="1360"
        Height="880"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{StaticResource Semantic.Brush.SurfaceInset}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusDisabled}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusHealthy}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                    <Setter Property="BorderBrush" Value="{StaticResource Semantic.Brush.StatusFailed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusDisabled}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusHealthy}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource Semantic.Brush.StatusFailed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectorLabelTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HintTextStyle}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="InspectorValueTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DetailTextStyle}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InspectorSectionTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SectionTitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="编辑配置" Command="{Binding EditConfigCommand}" />
                <MenuItem Header="打开日志目录" Command="{Binding OpenLogsCommand}" />
                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="系统诊断" Command="{Binding DoctorCommand}" />
                <MenuItem Header="Windows 启动项" Command="{Binding OpenStartupManagerCommand}" />
                <MenuItem Header="添加程序任务" Command="{Binding AddProgramCommand}" />
                <Separator />
                <MenuItem Header="安装系统启动执行器" Click="InstallBoot_Click" />
                <MenuItem Header="卸载系统启动执行器" Click="UninstallBoot_Click" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" MinHeight="30">
            <TextBlock Margin="4,0,8,0"
                       FontFamily="Segoe Fluent Icons"
                       Foreground="{StaticResource Semantic.Brush.FocusAccent}"
                       Text="&#xE946;" />
            <TextBlock Text="{Binding StatusMessage}" />
            <ProgressBar Width="72"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Style="{StaticResource BusyProgressStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Separator />
            <TextBlock HorizontalAlignment="Right" Text="{Binding CountMessage}" />
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Semantic.Brush.SurfacePrimary}"
                    BorderBrush="{StaticResource Semantic.Brush.BorderStrong}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="SystemAutorun" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource PageSubtitleTextStyle}"
                                   Text="启动任务工作台" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <StackPanel Width="72">
                            <TextBlock Style="{StaticResource MetricValueTextStyle}"
                                       Text="{Binding TotalTaskCount}" />
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="全部" />
                        </StackPanel>
                        <Border Height="34"
                                Margin="14,0"
                                BorderBrush="{StaticResource Semantic.Brush.BorderStrong}"
                                BorderThickness="1,0,0,0" />
                        <StackPanel Width="64">
                            <TextBlock Style="{StaticResource MetricValueTextStyle}"
                                       Foreground="{StaticResource Semantic.Brush.StatusHealthy}"
                                       Text="{Binding OkTaskCount}" />
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="OK" />
                        </StackPanel>
                        <StackPanel Width="64">
                            <TextBlock Style="{StaticResource MetricValueTextStyle}"
                                       Foreground="{StaticResource Semantic.Brush.StatusFailed}"
                                       Text="{Binding FailedTaskCount}" />
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="FAIL" />
                        </StackPanel>
                        <StackPanel Width="64">
                            <TextBlock Style="{StaticResource MetricValueTextStyle}"
                                       Foreground="{StaticResource Semantic.Brush.StatusDisabled}"
                                       Text="{Binding DisabledTaskCount}" />
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="OFF" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource Semantic.Brush.WindowBackground}"
                    BorderBrush="{StaticResource Semantic.Brush.BorderSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             AutomationProperties.Name="搜索任务"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索任务" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding StatusFilters}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding TypeFilters}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTypeFilter}" />
                    <CheckBox Grid.Column="6"
                              VerticalAlignment="Center"
                              Content="自动刷新"
                              IsChecked="{Binding AutoRefresh}" />

                    <Button Grid.Column="8"
                            AutomationProperties.Name="刷新状态"
                            Style="{StaticResource IconToolbarButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="&#xE72C;"
                            ToolTip="刷新状态" />
                    <Button Grid.Column="10"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding StartMissingCommand}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE768;" />
                            <TextBlock Text="补启动" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="12"
                            Style="{StaticResource ToolbarPrimaryButtonStyle}"
                            Command="{Binding AddProgramCommand}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE710;" />
                            <TextBlock Text="添加任务" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="660" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="420" MinWidth="400" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <DataGrid x:Name="TaskGrid"
                                  ItemsSource="{Binding TasksView}"
                                  SelectedItem="{Binding SelectedTask}"
                                  MouseDoubleClick="TaskGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="状态" Width="76" CanUserSort="True" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Center" Style="{StaticResource StatusBadgeBorderStyle}">
                                                <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{Binding Status}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="任务" Width="2*" MinWidth="190" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="Medium"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="目标" Width="150" SortMemberPath="Type">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{StaticResource Semantic.Brush.TextSecondary}"
                                                       Text="{Binding TargetSummary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="运行状态" Width="3*" MinWidth="240" SortMemberPath="Reason">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ReasonLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{StaticResource Semantic.Brush.SurfacePrimary}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="32"
                                           Foreground="{StaticResource Semantic.Brush.FocusAccent}"
                                           Text="&#xE710;" />
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource PanelTitleTextStyle}"
                                           Text="{Binding EmptyStateTitle}" />
                                <TextBlock Margin="0,5,0,16"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="{Binding EmptyStateMessage}" />
                                <Button Style="{StaticResource ToolbarPrimaryButtonStyle}"
                                        Command="{Binding EmptyStateActionCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,7,0"
                                                   FontFamily="Segoe Fluent Icons"
                                                   Text="{Binding EmptyStateActionIcon}" />
                                        <TextBlock Text="{Binding EmptyStateActionLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              Background="Transparent" />

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="28"
                                       Foreground="{StaticResource Semantic.Brush.TextHint}"
                                       Text="&#xE8A5;" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Text="未选择任务" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                                   Text="{Binding SelectedTask.Name}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Text="{Binding SelectedTask.TargetSummary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            DataContext="{Binding SelectedTask}"
                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                        <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                                   Text="{Binding Status, FallbackValue=OFF}" />
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{StaticResource Semantic.Brush.TextSecondary}"
                                           Text="{Binding SelectedTask.Description}"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,14,0,14"
                                        BorderBrush="{StaticResource Semantic.Brush.BorderSubtle}"
                                        BorderThickness="0,1,0,0" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource InspectorLabelTextStyle}" Text="状态" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource InspectorValueTextStyle}"
                                               Text="{Binding SelectedTask.ReasonLabel}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource InspectorLabelTextStyle}" Text="详情" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Style="{StaticResource InspectorValueTextStyle}"
                                               Text="{Binding SelectedTask.Detail}"
                                               ToolTip="{Binding SelectedTask.Detail}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource InspectorLabelTextStyle}" Text="启动模式" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Style="{StaticResource InspectorValueTextStyle}"
                                               Text="{Binding SelectedTask.LaunchSummary}" />
                                    <TextBlock Grid.Row="6" Style="{StaticResource InspectorLabelTextStyle}" Text="启动延迟" />
                                    <TextBlock Grid.Row="6"
                                               Grid.Column="1"
                                               Style="{StaticResource InspectorValueTextStyle}"
                                               Text="{Binding SelectedTask.StartupDelayText}" />
                                    <TextBlock Grid.Row="8" Style="{StaticResource InspectorLabelTextStyle}" Text="可执行文件" />
                                    <TextBlock Grid.Row="8"
                                               Grid.Column="1"
                                               Style="{StaticResource InspectorValueTextStyle}"
                                               Text="{Binding SelectedTask.ExecutableDisplay}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding SelectedTask.ExecutableDisplay}" />
                                </Grid>

                                <Border Margin="0,16,0,14"
                                        BorderBrush="{StaticResource Semantic.Brush.BorderSubtle}"
                                        BorderThickness="0,1,0,0" />

                                <TextBlock Style="{StaticResource InspectorSectionTextStyle}" Text="任务操作" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource InspectorPrimaryButtonStyle}"
                                            Command="{Binding StartCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE768;" />
                                            <TextBlock Text="启动" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Style="{StaticResource InspectorDangerButtonStyle}"
                                            Command="{Binding StopCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE71A;" />
                                            <TextBlock Text="停止" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource InspectorActionButtonStyle}"
                                            Command="{Binding RestartCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                                            <TextBlock Text="重启" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{StaticResource InspectorActionButtonStyle}"
                                            Command="{Binding ShowDetailCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE946;" />
                                            <TextBlock Text="状态与日志" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="4"
                                            Grid.Column="0"
                                            Style="{StaticResource InspectorActionButtonStyle}"
                                            Command="{Binding EnableCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE73E;" />
                                            <TextBlock Text="启用" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{StaticResource InspectorDangerButtonStyle}"
                                            Command="{Binding DisableCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE711;" />
                                            <TextBlock Text="禁用" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Margin="0,18,0,10"
                                           Style="{StaticResource InspectorSectionTextStyle}"
                                           Text="文件与配置" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource InspectorActionButtonStyle}"
                                            Command="{Binding OpenLogsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" />
                                            <TextBlock Text="打开日志" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource InspectorActionButtonStyle}"
                                            Command="{Binding EditConfigCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE70F;" />
                                            <TextBlock Text="编辑配置" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button Margin="0,18,0,0"
                                        Style="{StaticResource InspectorDangerButtonStyle}"
                                        Command="{Binding RemoveTaskCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE74D;" />
                                        <TextBlock Text="移出任务列表" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="{StaticResource Semantic.Brush.SurfaceInset}"
                    BorderBrush="{StaticResource Semantic.Brush.BorderStrong}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              Content="登录后后台运行"
                              IsChecked="{Binding IsSelfStartupEnabled}"
                              Click="SelfStartup_Click" />
                    <CheckBox Grid.Column="2"
                              VerticalAlignment="Center"
                              Content="启动后补齐未运行任务"
                              IsChecked="{Binding StartMissingOnLaunch}" />
                    <Button Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenStartupManagerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE713;" />
                            <TextBlock Text="Windows 启动项" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
